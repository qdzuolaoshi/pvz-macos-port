+// ---------------------------------------------------------------------------------------------
+// Legacy compiled definitions (PvZ 1.0.0.1051 main.pak ships only compiled/*.compiled files,
+// no XML sources). They use the original 32-bit layout: [hash][raw struct][fixups in DefMap
+// order], where pointers are 4 bytes and track/array members are {ptr, count} pairs (8 bytes).
+// The reader below rebuilds native definitions from that layout.
+// ---------------------------------------------------------------------------------------------
+namespace
+{
+struct LegacyFieldDecl { const char* mName; int mSlotSize; };
+
+struct LegacyLayout
+{
+	const DefMap* mDefMap;
+	int mSize;
+	std::vector<std::pair<std::string, int>> mOffsets;
+};
+
+LegacyLayout MakeLegacyLayout(const DefMap* theDefMap, std::initializer_list<LegacyFieldDecl> theDecl)
+{
+	LegacyLayout aLayout{ theDefMap, 0, {} };
+	for (const LegacyFieldDecl& aDecl : theDecl)
+	{
+		aLayout.mOffsets.emplace_back(aDecl.mName, aLayout.mSize);
+		aLayout.mSize += aDecl.mSlotSize;
+	}
+	return aLayout;
+}
+
+const std::vector<LegacyLayout>& GetLegacyLayouts()
+{
+	static const std::vector<LegacyLayout> aLayouts = [] {
+		constexpr int S = 4; // scalar or pointer
+		constexpr int P = 8; // FloatParameterTrack or array {pointer, count}
+		std::vector<LegacyLayout> v;
+		v.push_back(MakeLegacyLayout(&gReanimatorTransformDefMap, {
+			{"x",S},{"y",S},{"kx",S},{"ky",S},{"sx",S},{"sy",S},{"f",S},{"a",S},{"i",S},{"font",S},{"text",S} }));
+		v.push_back(MakeLegacyLayout(&gReanimatorTrackDefMap, { {"name",S},{"t",P} }));
+		v.push_back(MakeLegacyLayout(&gReanimatorDefMap, { {"track",P},{"fps",S},{"<atlas>",S} }));
+		v.push_back(MakeLegacyLayout(&gParticleFieldDefMap, { {"FieldType",S},{"x",P},{"y",P} }));
+		v.push_back(MakeLegacyLayout(&gEmitterDefMap, {
+			{"Image",S},{"ImageCol",S},{"ImageRow",S},{"ImageFrames",S},{"Animated",S},{"ParticleFlags",S},
+			{"EmitterType",S},{"Name",S},{"OnDuration",S},
+			{"SystemDuration",P},{"CrossFadeDuration",P},{"SpawnRate",P},{"SpawnMinActive",P},{"SpawnMaxActive",P},
+			{"SpawnMaxLaunched",P},{"EmitterRadius",P},{"EmitterOffsetX",P},{"EmitterOffsetY",P},{"EmitterBoxX",P},
+			{"EmitterBoxY",P},{"EmitterSkewX",P},{"EmitterSkewY",P},{"EmitterPath",P},{"ParticleDuration",P},
+			{"LaunchSpeed",P},{"LaunchAngle",P},{"SystemRed",P},{"SystemGreen",P},{"SystemBlue",P},{"SystemAlpha",P},
+			{"SystemBrightness",P},{"Field",P},{"SystemField",P},
+			{"ParticleRed",P},{"ParticleGreen",P},{"ParticleBlue",P},{"ParticleAlpha",P},{"ParticleBrightness",P},
+			{"ParticleSpinAngle",P},{"ParticleSpinSpeed",P},{"ParticleScale",P},{"ParticleStretch",P},
+			{"CollisionReflect",P},{"CollisionSpin",P},{"ClipTop",P},{"ClipBottom",P},{"ClipLeft",P},{"ClipRight",P},
+			{"AnimationRate",P} }));
+		v.push_back(MakeLegacyLayout(&gParticleDefMap, { {"Emitter",P} }));
+		v.push_back(MakeLegacyLayout(&gTrailDefMap, {
+			{"Image",S},{"MaxPoints",S},{"MinPointDistance",S},{"TrailFlags",S},{"TrailDuration",P},
+			{"WidthOverLength",P},{"WidthOverTime",P},{"AlphaOverLength",P},{"AlphaOverTime",P} }));
+		return v;
+	}();
+	return aLayouts;
+}
+
+const LegacyLayout* FindLegacyLayout(const DefMap* theDefMap)
+{
+	for (const LegacyLayout& aLayout : GetLegacyLayouts())
+		if (aLayout.mDefMap == theDefMap)
+			return &aLayout;
+	return nullptr;
+}
+
+int LegacyFieldOffset(const LegacyLayout& theLayout, const char* theName)
+{
+	for (const auto& [aName, anOffset] : theLayout.mOffsets)
+		if (aName == theName)
+			return anOffset;
+	return -1;
+}
+
+struct LegacyReader
+{
+	const uint8_t* mData;
+	size_t mSize;
+	size_t mPos = 0;
+
+	bool Read(void* theDest, size_t theLen)
+	{
+		if (mPos + theLen > mSize) return false;
+		memcpy(theDest, mData + mPos, theLen);
+		mPos += theLen;
+		return true;
+	}
+	bool ReadInt(int32_t& theValue) { return Read(&theValue, sizeof(int32_t)); }
+	bool ReadName(std::string& theName)
+	{
+		int32_t aLen;
+		if (!ReadInt(aLen) || aLen < 0 || (size_t)aLen > mSize - mPos) return false;
+		theName.assign(reinterpret_cast<const char*>(mData + mPos), aLen);
+		mPos += aLen;
+		return true;
+	}
+};
+
+bool LegacyReadMap(LegacyReader& theReader, const DefMap* theDefMap, const uint8_t* theLegacyRaw, void* theDefinition);
+
+bool LegacyReadArray(LegacyReader& theReader, const DefMap* theSubMap, int theCount, DefinitionArrayDef* theArray)
+{
+	const LegacyLayout* aSubLayout = FindLegacyLayout(theSubMap);
+	int32_t aDefSize;
+	if (!aSubLayout || !theReader.ReadInt(aDefSize) || aDefSize != aSubLayout->mSize || theCount < 0)
+		return false;
+	theArray->mArrayCount = theCount;
+	theArray->mArrayData = nullptr;
+	if (theCount == 0)
+		return true;
+
+	std::vector<uint8_t> aRaw((size_t)aDefSize * theCount);
+	if (!theReader.Read(aRaw.data(), aRaw.size()))
+		return false;
+	theArray->mArrayData = DefinitionAlloc(theSubMap->mDefSize * theCount);
+	for (int i = 0; i < theCount; i++)
+	{
+		void* anElem = (void*)((intptr_t)theArray->mArrayData + theSubMap->mDefSize * i);
+		theSubMap->mConstructorFunc(anElem);
+		if (!LegacyReadMap(theReader, theSubMap, aRaw.data() + (size_t)aDefSize * i, anElem))
+			return false;
+	}
+	return true;
+}
+
+bool LegacyReadMap(LegacyReader& theReader, const DefMap* theDefMap, const uint8_t* theLegacyRaw, void* theDefinition)
+{
+	const LegacyLayout* aLayout = FindLegacyLayout(theDefMap);
+	if (!aLayout)
+		return false;
+
+	for (const DefField* aField = theDefMap->mMapFields; *aField->mFieldName != '\0'; aField++)
+	{
+		int aLegacyOffset = LegacyFieldOffset(*aLayout, aField->mFieldName);
+		if (aLegacyOffset < 0)
+			return false;
+		const uint8_t* aSrc = theLegacyRaw + aLegacyOffset;
+		void* aDest = (void*)((intptr_t)theDefinition + aField->mFieldOffset);
+		switch (aField->mFieldType)
+		{
+		case DefFieldType::DT_INT:
+		case DefFieldType::DT_ENUM:
+		case DefFieldType::DT_FLAGS:
+		case DefFieldType::DT_FLOAT:
+			memcpy(aDest, aSrc, 4);
+			break;
+		case DefFieldType::DT_STRING:
+		{
+			std::string aValue;
+			if (!theReader.ReadName(aValue)) return false;
+			if (aValue.empty())
+				*(const char**)aDest = "";
+			else
+			{
+				char* aStr = static_cast<char*>(DefinitionAlloc((int)aValue.size() + 1));
+				memcpy(aStr, aValue.data(), aValue.size());
+				*(const char**)aDest = aStr;
+			}
+			break;
+		}
+		case DefFieldType::DT_IMAGE:
+		{
+			std::string aName;
+			if (!theReader.ReadName(aName)) return false;
+			*(Image**)aDest = nullptr;
+			if (!aName.empty() && !DefinitionLoadImage((Image**)aDest, aName))
+			{
+				PvzpLogLn("Legacy definition: can't find image '{}'", aName);
+				return false;
+			}
+			break;
+		}
+		case DefFieldType::DT_FONT:
+		{
+			std::string aName;
