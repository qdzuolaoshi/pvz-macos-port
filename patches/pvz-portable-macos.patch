+
+static bool DefinitionReadLegacyCompiledFile(const std::string& theCompiledFilePath, const DefMap* theDefMap, void* theDefinition)
+{
+	const LegacyLayout* aLayout = FindLegacyLayout(theDefMap);
+	if (!aLayout)
+		return false;
+
+	PFILE* aFile = p_fopen(theCompiledFilePath.c_str(), "rb");
+	if (!aFile)
+		return false;
+	std::vector<uint8_t> aCompressed;
+	uint8_t aChunk[65536];
+	size_t aRead;
+	while ((aRead = p_fread(aChunk, 1, sizeof(aChunk), aFile)) > 0)
+		aCompressed.insert(aCompressed.end(), aChunk, aChunk + aRead);
+	p_fclose(aFile);
+
+	size_t aSize = 0;
+	std::unique_ptr<uint8_t[]> aBuffer(static_cast<uint8_t*>(
+		DefinitionUncompressCompiledBuffer(aCompressed.data(), aCompressed.size(), aSize, theCompiledFilePath)));
+	if (!aBuffer || aSize < (size_t)aLayout->mSize + 4)
+		return false;
+
+	LegacyReader aReader{ aBuffer.get(), aSize };
+	aReader.mPos = 4; // skip the original schema hash
+	std::vector<uint8_t> aRaw(aLayout->mSize);
+	if (!aReader.Read(aRaw.data(), aRaw.size()))
+		return false;
+	if (!LegacyReadMap(aReader, theDefMap, aRaw.data(), theDefinition) || aReader.mPos != aSize)
+	{
+		PvzpLogLn("Legacy compiled file malformed: {}", theCompiledFilePath);
+		return false;
+	}
+	return true;
+}
