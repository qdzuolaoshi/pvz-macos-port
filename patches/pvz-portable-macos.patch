 }
 
+// ARGB -> GL RGBA bytes with the colour multiplied by alpha (rounded), for premultiplied textures.
+static inline uint32_t ArgbToRgbaPremultiplied(uint32_t argb) noexcept
+{
+	const uint32_t a = argb >> 24;
+	if (a == 0xFF)
+		return ArgbToRgba(argb);
+	auto mul = [a](uint32_t c) -> uint32_t { const uint32_t t = c * a + 128; return (t + (t >> 8)) >> 8; };
+	const uint32_t r = mul((argb >> 16) & 0xFF), g = mul((argb >> 8) & 0xFF), b = mul(argb & 0xFF);
+	return ArgbToRgba((a << 24) | (r << 16) | (g << 8) | b);
+}
+
 static inline uint32_t RgbaToArgb(uint32_t rgba) noexcept
 {
 	uint32_t abgr = FromLE32(rgba);
@@ -83,9 +96,66 @@ static std::vector<GLVertex> gVertices;
 static int gNumVertices;
 static int gPrimitiveStart;
 static GLenum gVertexMode;
-static GLuint gProgram;
 static GLuint gVbo;
-static GLint gUfViewProjMtx, gUfTexture, gUfUseTexture, gUfUvBounds, gUfClampUvEnabled, gUfMixedBlend;
+
+// Magnification on a high-resolution drawable. The 800x600 scene is drawn straight into the drawable, so when the
+// presentation rect has more pixels than the scene (HiDPI / Retina, large windows, fullscreen) every texture is
+// magnified. Hardware bilinear filtering looks soft at 2x-4x, so magnified linear draws are sampled in the fragment
+// shader with a cubic kernel instead, and magnified nearest draws with "sharp bilinear" (see SHADER_CODE). At a
+// presentation scale of 1 nothing changes. PVZP_FILTER=catmullrom (alias bicubic) | mitchell | bilinear selects the
+// kernel; bilinear keeps plain hardware sampling for every draw (for A/B comparison).
+// Default: Catmull-Rom. On busy scenes (lawn, almanac, seed chooser, menu) it was clearly sharper than bilinear and
+// Mitchell (Mitchell's B = 1/3 blur leaves it close to bilinear).
+// Cost: the cubic path takes five bilinear fetches per fragment (see SampleCubic). Textures with alpha that are
+// created for a magnified presentation store premultiplied colour, so those fetches never mix in the colour of
+// transparent texels and the same cheap path serves opaque and transparent images.
+enum GfxFilterKind { GFX_FILTER_BILINEAR, GFX_FILTER_CATMULL_ROM, GFX_FILTER_MITCHELL };
+static constexpr GfxFilterKind DEFAULT_FILTER_KIND = GFX_FILTER_CATMULL_ROM;
+
+enum GfxFilterMode // u_filterMode
+{
+	GFX_MODE_HARDWARE		= 0,	// GL_LINEAR / GL_NEAREST as requested
+	GFX_MODE_CUBIC			= 1,	// cubic, five bilinear fetches (opaque or premultiplied texture)
+	GFX_MODE_SHARP_BILINEAR	= 3,	// nearest draws at a non-integer magnification
+};
+
+static GfxFilterKind gFilterKind = DEFAULT_FILTER_KIND;
+static float gPresentScale = 1.0f;		// GLInterface::mPresentationScale
+static float gDrawMagnification = 1.0f;	// drawable pixels per texel of the textured draw being recorded
+
+// Budget for the cubic path. Each frame counts the drawable pixels of the draws that qualify for cubic filtering.
+// While the previous frames exceeded the budget, sprites (matrix-transformed images and textured triangles: plants,
+// zombies, projectiles, particles) are drawn with hardware bilinear filtering ("economy") and every other image
+// keeps the cubic kernel; sprites are numerous and stacked, so on a busy lawn they make up most of the filtered
+// pixels. Below 3/4 of the budget, after at least a second in economy, sprites return to cubic.
+// The budget is in drawable pixels per frame, because the cost is: the same lawn needs more pixels at a larger
+// presentation. Calibrated on the user's Mac (M2) with a late-game endless pool lawn: at the clocks the GPU chose,
+// frames started to miss the 60 Hz deadline at about 37 million cubic pixels per frame (sprites plus background and
+// UI; quads are counted whole). That lawn reaches about 54 million at a 2592x1944 presentation and 20 million in the
+// default 800x600-point window, which stays cubic. PVZP_CUBIC_BUDGET (in megapixels) overrides the budget; 0 draws
+// every sprite bilinear, a huge value never does.
+static constexpr float DEFAULT_CUBIC_BUDGET = 26.0e6f;
