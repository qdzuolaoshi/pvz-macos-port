diff --git a/src/SexyAppFramework/graphics/CjkFallbackFont.cpp b/src/SexyAppFramework/graphics/CjkFallbackFont.cpp
new file mode 100644
index 0000000..faf031f
--- /dev/null
+++ b/src/SexyAppFramework/graphics/CjkFallbackFont.cpp
@@ -0,0 +1,182 @@
+/*
+ * SPDX-License-Identifier: LGPL-3.0-or-later
+ */
+
+#define STB_TRUETYPE_IMPLEMENTATION
+#define STBTT_STATIC
+#include "stb_truetype.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include "CjkFallbackFont.h"
+#include "GLImage.h"
+#include "GLInterface.h"
+#include "SexyAppBase.h"
+#include "paklib/PakInterface.h"
+#include "misc/PvzpHitch.h"
+
+namespace Sexy
+{
+
+struct CjkFallbackFont::Impl
+{
+	stbtt_fontinfo mInfo{};
+};
+
+static std::once_flag gCjkOnce;
+static CjkFallbackFont* gCjkFont = nullptr;
+
+CjkFallbackFont* CjkFallbackFont::Get()
+{
+	std::call_once(gCjkOnce, [] {
+		CjkFallbackFont* aFont = new CjkFallbackFont();
+		if (aFont->Load())
+			gCjkFont = aFont;
+		else
+			delete aFont;
+	});
+	return gCjkFont;
+}
+
+CjkFallbackFont::~CjkFallbackFont() = default;
+
+bool CjkFallbackFont::Load()
+{
+	PFILE* aFile = p_fopen("fzse_gbk.ttf", "rb");
+	if (aFile == nullptr)
+		return false;
+	uint8_t aChunk[65536];
+	size_t aRead;
+	while ((aRead = p_fread(aChunk, 1, sizeof(aChunk), aFile)) > 0)
+		mFontData.insert(mFontData.end(), aChunk, aChunk + aRead);
+	p_fclose(aFile);
+
+	mImpl = std::make_unique<Impl>();
+	int anOffset = stbtt_GetFontOffsetForIndex(mFontData.data(), 0);
+	return anOffset >= 0 && stbtt_InitFont(&mImpl->mInfo, mFontData.data(), anOffset) != 0;
+}
+
+bool CjkFallbackFont::HasGlyph(char32_t theChar)
+{
+	std::scoped_lock aLock(mMutex);
+	return stbtt_FindGlyphIndex(&mImpl->mInfo, (int)theChar) != 0;
+}
+
+int CjkFallbackFont::GetAdvance(char32_t theChar, int thePixelSize)
+{
+	const Glyph* aGlyph = GetGlyph(theChar, thePixelSize);
+	return aGlyph ? aGlyph->mAdvance : 0;
+}
+
+const CjkFallbackFont::Glyph* CjkFallbackFont::GetGlyph(char32_t theChar, int thePixelSize)
+{
+	std::scoped_lock aLock(mMutex);
+	thePixelSize = std::clamp(thePixelSize, 6, 256);
+	uint64_t aKey = ((uint64_t)thePixelSize << 32) | (uint32_t)theChar;
+	auto anItr = mGlyphs.find(aKey);
+	if (anItr != mGlyphs.end())
+		return &anItr->second;
+
+	Glyph aGlyph;
+	stbtt_fontinfo* anInfo = &mImpl->mInfo;
+	// GDI CreateFont with a negative height maps the em square to that many pixels.
+	float aScale = stbtt_ScaleForMappingEmToPixels(anInfo, (float)thePixelSize);
+	int anAdvance = 0, aLsb = 0;
+	stbtt_GetCodepointHMetrics(anInfo, (int)theChar, &anAdvance, &aLsb);
+	aGlyph.mAdvance = (int)std::lround(anAdvance * aScale);
+
+	int x0, y0, x1, y1;
+	stbtt_GetCodepointBitmapBox(anInfo, (int)theChar, aScale, aScale, &x0, &y0, &x1, &y1);
+	int w = x1 - x0, h = y1 - y0;
+	if (w > 0 && h > 0)
+	{
+		PvzpHitchScope aHitchScope(HITCH_GLYPHS, HITCH_GLYPH_US);
+		std::vector<uint8_t> aCoverage((size_t)w * h);
+		stbtt_MakeCodepointBitmap(anInfo, aCoverage.data(), w, h, w, aScale, aScale, (int)theChar);
+
+		GLImage* anImage = new GLImage(gSexyAppBase->mGLInterface.get());
+		anImage->Create(w, h);
+		uint32_t* aBits = anImage->GetBits();
+		for (int i = 0; i < w * h; i++)
+			aBits[i] = ((uint32_t)aCoverage[i] << 24) | 0x00FFFFFFu;
+		anImage->BitsChanged();
+		aGlyph.mImage = anImage;
+		aGlyph.mXOffset = x0;
+		aGlyph.mYOffset = y0;
+		aGlyph.mWidth = w;
+		aGlyph.mHeight = h;
+	}
+
+	return &mGlyphs.emplace(aKey, aGlyph).first->second;
+}
+
+// Scale steps of 1/64: a window resize or an animated text scale cannot create unbounded glyph variants, and the
+// resulting size error (at most 1/128 of the scale) keeps bitmap pixels within 0.4% of drawable pixels.
+static constexpr int SCALED_GLYPH_STEPS = 64;
+static constexpr float SCALED_GLYPH_MAX_EM = 400.0f;							// bitmap pixels
+static constexpr size_t SCALED_GLYPH_BUDGET_BYTES = 24u * 1024u * 1024u;	// glyph bitmaps (textures add about as much)
+
+const CjkFallbackFont::ScaledGlyph* CjkFallbackFont::GetScaledGlyph(char32_t theChar, int thePixelSize, float theScale)
+{
+	std::scoped_lock aLock(mMutex);
+	thePixelSize = std::clamp(thePixelSize, 6, 256);
+	float aScale = std::min(theScale, SCALED_GLYPH_MAX_EM / thePixelSize);
+	int aScaleKey = std::clamp((int)std::lround(aScale * SCALED_GLYPH_STEPS), SCALED_GLYPH_STEPS / 8, 0xFFFF);
+	uint64_t aKey = ((uint64_t)aScaleKey << 48) | ((uint64_t)thePixelSize << 32) | (uint32_t)theChar;
+	auto anItr = mScaledGlyphs.find(aKey);
+	if (anItr != mScaledGlyphs.end())
+		return &anItr->second;
+
+	ScaledGlyph aGlyph;
+	aGlyph.mScale = (float)aScaleKey / SCALED_GLYPH_STEPS;
+	stbtt_fontinfo* anInfo = &mImpl->mInfo;
+	float anStbScale = stbtt_ScaleForMappingEmToPixels(anInfo, thePixelSize * aGlyph.mScale);
+	int x0, y0, x1, y1;
+	stbtt_GetCodepointBitmapBox(anInfo, (int)theChar, anStbScale, anStbScale, &x0, &y0, &x1, &y1);
+	int w = x1 - x0, h = y1 - y0;
+	if (w > 0 && h > 0)
+	{
+		PvzpHitchScope aHitchScope(HITCH_GLYPHS, HITCH_GLYPH_US);
+		std::vector<uint8_t> aCoverage((size_t)w * h);
+		stbtt_MakeCodepointBitmap(anInfo, aCoverage.data(), w, h, w, anStbScale, anStbScale, (int)theChar);
+
+		GLImage* anImage = new GLImage(gSexyAppBase->mGLInterface.get());
+		anImage->Create(w, h);
+		uint32_t* aBits = anImage->GetBits();
+		for (int i = 0; i < w * h; i++)
+			aBits[i] = ((uint32_t)aCoverage[i] << 24) | 0x00FFFFFFu;
+		anImage->BitsChanged();
+		aGlyph.mImage = anImage;
+		aGlyph.mXOffset = x0;
+		aGlyph.mYOffset = y0;
+		aGlyph.mWidth = w;
+		aGlyph.mHeight = h;
+		mScaledGlyphBytes += (size_t)w * h * 4;
+	}
+
+	return &mScaledGlyphs.emplace(aKey, aGlyph).first->second;
+}
+
+void CjkFallbackFont::TrimScaledGlyphs(float thePresentationScale)
+{
+	std::scoped_lock aLock(mMutex);
+	int aPresentationKey = (int)std::lround(thePresentationScale * SCALED_GLYPH_STEPS);
+	if (aPresentationKey == mScaledGlyphPresentationKey && mScaledGlyphBytes <= SCALED_GLYPH_BUDGET_BYTES)
+		return;
+	mScaledGlyphPresentationKey = aPresentationKey;
+	PvzpHitchCount(HITCH_GLYPH_TRIMS);
+	for (auto& anEntry : mScaledGlyphs)
+		delete anEntry.second.mImage; // releases its texture (pending draws are flushed first)
+	mScaledGlyphs.clear();
+	mScaledGlyphBytes = 0;
+}
+
+int CjkFallbackPixelSize(int theLayerPointSize, int theLayerAscent, double theScale)
+{
+	int aBase = theLayerPointSize > 0 ? theLayerPointSize : theLayerAscent;
+	aBase = std::max(aBase, 12);
+	return std::max(6, (int)std::lround(aBase * theScale));
+}
+
+}
diff --git a/src/SexyAppFramework/graphics/CjkFallbackFont.h b/src/SexyAppFramework/graphics/CjkFallbackFont.h
new file mode 100644
index 0000000..9e1c553
--- /dev/null
+++ b/src/SexyAppFramework/graphics/CjkFallbackFont.h
@@ -0,0 +1,86 @@
+/*
+ * TrueType fallback for characters that a bitmap ImageFont does not contain.
+ *
+ * The PvZ 1.0.0.1051 Chinese fan translation keeps the original bitmap fonts for Latin text and
+ * draws Chinese characters through GDI with the bundled font file fzse_gbk.ttf (FZShaoEr GBK).
+ * This class reproduces that path portably: glyphs are rasterised with stb_truetype from the same
+ * font file and cached as white images that ImageFont colourises like its own glyphs.
+ *
+ * SPDX-License-Identifier: LGPL-3.0-or-later
+ */
+
+#ifndef __CJKFALLBACKFONT_H__
+#define __CJKFALLBACKFONT_H__
+
+#include <cstdint>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <vector>
+
+namespace Sexy
+{
+class Image;
+class GLImage;
+
+class CjkFallbackFont
+{
+public:
+	struct Glyph
+	{
+		GLImage*	mImage = nullptr;   // nullptr for blank glyphs (spaces)
+		int			mXOffset = 0;       // from pen position
+		int			mYOffset = 0;       // from baseline (negative is up)
+		int			mWidth = 0;
+		int			mHeight = 0;
+		int			mAdvance = 0;
+	};
+
+	// A glyph rasterised for a magnified display: the same em as GetGlyph(theChar, thePixelSize) with mScale bitmap
+	// pixels per logical pixel. Offsets and size are in bitmap pixels; layout keeps using the logical Glyph.
+	struct ScaledGlyph
+	{
+		GLImage*	mImage = nullptr;   // nullptr for blank glyphs (spaces)
+		int			mXOffset = 0;       // from the pen position, bitmap pixels
+		int			mYOffset = 0;       // from the baseline (negative is up), bitmap pixels
+		int			mWidth = 0;
+		int			mHeight = 0;
+		float		mScale = 1.0f;      // bitmap pixels per logical pixel (theScale quantised to 1/64)
+	};
+
+	// Returns nullptr when the font file is unavailable.
+	static CjkFallbackFont*	Get();
+
+	bool					HasGlyph(char32_t theChar);
+	const Glyph*			GetGlyph(char32_t theChar, int thePixelSize);
+	int						GetAdvance(char32_t theChar, int thePixelSize);
+
+	// The returned glyph stays valid until the next TrimScaledGlyphs call.
+	const ScaledGlyph*		GetScaledGlyph(char32_t theChar, int thePixelSize, float theScale);
+	// Releases every scaled glyph when thePresentationScale differs from the previous call (the window was resized
+	// or moved to another display) or the cache exceeds its memory budget. Call it only at the start of a string,
+	// before that string fetches any glyph, so no ScaledGlyph still in use is released.
+	void					TrimScaledGlyphs(float thePresentationScale);
+
+	~CjkFallbackFont();
+
+private:
+	CjkFallbackFont() = default;
+	bool					Load();
+
+	struct Impl;
+	std::unique_ptr<Impl>	mImpl;
+	std::vector<uint8_t>	mFontData;
+	std::map<uint64_t, Glyph> mGlyphs;
+	std::map<uint64_t, ScaledGlyph> mScaledGlyphs;
+	size_t					mScaledGlyphBytes = 0;
+	int						mScaledGlyphPresentationKey = 0;
+	std::recursive_mutex	mMutex;
+};
+
+// Pixel size used for fallback glyphs of a font layer with the given point size / ascent.
+int CjkFallbackPixelSize(int theLayerPointSize, int theLayerAscent, double theScale);
+
+}
+
+#endif
diff --git a/src/SexyAppFramework/graphics/GLInterface.cpp b/src/SexyAppFramework/graphics/GLInterface.cpp
