+// The sun counter's paper label in IMAGE_SEEDBANK (IMAGE_SUNBANK has the same paper): its white area spans
+// x 11.6..66.3 and y 61.2..82.8, with tape over both top corners.
+constexpr const float SUN_LABEL_PAPER_CENTER_X = 38.95f;
+constexpr const float SUN_LABEL_PAPER_CENTER_Y = 72.0f;
+// Widest ink drawn at full size: the paper less about 4 px each side. Every 4-digit number fits (at most 46 px); the
+// corners of a wide 4-digit label still reach the tape a little, which full-size digits cannot avoid on this paper.
+constexpr const float SUN_LABEL_MAX_INK_WIDTH = 46.0f;
+// A longer label is scaled down uniformly until its ink width plus ink height is at most this. The tapes' inner edges
+// run at about 45 degrees, so the lower top edge of a smaller label lets it be wider: 5 digits come out about 41 px
+// wide and 11 px tall, 10 digits about 46 px wide and 6 px tall, and none of them reaches the tape. (At a 1:1
+// presentation 10 digits get under 5 drawable pixels each, so equal digits differ with their sub-pixel phase; an
+// area-averaging prefilter in place of bilinear sampling was tried and made them no more even, only lighter.)
+constexpr const float SUN_LABEL_MAX_SCALED_INK_EXTENT = 51.5f;
+// FONT_CONTINUUMBOLD14's digits are inked from 19 to 4 px above the baseline, anti-aliased rows included, and
+// their glyph images keep 4 transparent columns on each side of the ink.
+constexpr const float SUN_LABEL_INK_MIDDLE_ABOVE_BASELINE = 11.5f;
+constexpr const float SUN_LABEL_INK_HEIGHT = 15.0f;
+constexpr const int SUN_LABEL_GLYPH_BORDER = 4;
+
+// Horizontal extent of theLabel's ink with the pen at x 0: from the first glyph image's left edge to the last one's
+// right edge (the last image reaches past the advance width), less the transparent borders.
+static void SunLabelInkExtent(_Font* theFont, const std::string& theLabel, float& theLeft, float& theRight)
+{
+	const int aWidth = theFont->StringWidth(theLabel);
+	theLeft = 0.0f;
+	theRight = aWidth;
+	ImageFont* aFont = dynamic_cast<ImageFont*>(theFont);
+	if (aFont == nullptr || aFont->mActiveLayerList.empty() || theLabel.empty())
+		return;
+
+	FontLayer* aLayer = aFont->mActiveLayerList.front().mBaseFontLayer;
+	const char32_t aLastChar = static_cast<unsigned char>(theLabel.back());
+	const CharData* aFirst = aLayer->GetCharData(static_cast<unsigned char>(theLabel.front()));
+	const CharData* aLast = aLayer->GetCharData(aLastChar);
+	const int aLastPen = aWidth - theFont->CharWidth(aLastChar);
+	theLeft = aLayer->mOffset.mX + aFirst->mOffset.mX + SUN_LABEL_GLYPH_BORDER;
+	theRight = aLastPen + aLayer->mOffset.mX + aLast->mOffset.mX + aLast->mImageRect.mWidth - SUN_LABEL_GLYPH_BORDER;
+}
+
+// Draws the sun count centred on the paper label (Windows draws this ContinuumBold14 text through GDI, 4 px lower
+// than the bitmap font's baseline, so the original position 34, 78 sits high here). A label wider than the paper
+// (the 95 edition allows up to 2,000,000,000 sun) is scaled down uniformly about the paper's centre to fit between
+// the tapes.
+static void DrawSunMoneyLabel(Graphics* g, const std::string& theLabel, const Color& theColor)
+{
+	_Font* aFont = FONT_CONTINUUMBOLD14;
+	float aInkLeft, aInkRight;
+	SunLabelInkExtent(aFont, theLabel, aInkLeft, aInkRight);
+	const float aInkMiddleX = (aInkLeft + aInkRight) * 0.5f;
+	const float aInkWidth = aInkRight - aInkLeft;
+	if (aInkWidth <= SUN_LABEL_MAX_INK_WIDTH)
+	{
+		// Whole logical pixels, as before: the glyphs stay on the pixel grid at every presentation scale.
+		int aPosX = FloatRoundToInt(SUN_LABEL_PAPER_CENTER_X - aInkMiddleX);
+		int aPosY = FloatRoundToInt(SUN_LABEL_PAPER_CENTER_Y + SUN_LABEL_INK_MIDDLE_ABOVE_BASELINE);
+		PvzpDrawString(g, theLabel, aPosX, aPosY, aFont, theColor, DrawStringJustification::DS_ALIGN_LEFT);
+		return;
+	}
+
+	// PvzpDrawStringMatrix works in absolute coordinates: add the Graphics translation, and undo the half-pixel shift
+	// that PvzpBltMatrix applies to accelerated draws, so the label lands where a DrawString would put it.
+	const float aScale = std::min(1.0f, SUN_LABEL_MAX_SCALED_INK_EXTENT / (aInkWidth + SUN_LABEL_INK_HEIGHT));
+	const float aBltShift = gLawnApp->Is3DAccelerated() ? 0.5f : 0.0f;
+	SexyMatrix3 aMatrix;
+	PvzpScaleTransformMatrix(aMatrix,
+		g->mTransX + SUN_LABEL_PAPER_CENTER_X - aInkMiddleX * aScale + aBltShift,
+		g->mTransY + SUN_LABEL_PAPER_CENTER_Y + SUN_LABEL_INK_MIDDLE_ABOVE_BASELINE * aScale + aBltShift, aScale, aScale);
+	const bool aOldLinearBlend = g->GetLinearBlend();
+	g->SetLinearBlend(true);
+	PvzpDrawStringMatrix(g, aFont, aMatrix, theLabel, theColor);
+	g->SetLinearBlend(aOldLinearBlend);
+}
