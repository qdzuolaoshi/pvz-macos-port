+	int aWidth = 0;
+	char32_t aPrevKey = 0;
+	for (size_t i = 0; i < aBytes.size(); i++)
+	{
+		char32_t aKey = Sexy::Win1252ByteToCodepoint((uint8_t)aBytes[i]);
+		auto anItr = theLayer->mCharDataMap.find(aKey);
+		if (anItr != theLayer->mCharDataMap.end())
+			aWidth += anItr->second.mWidth;
+		if (i > 0 || theHasPrev)
+			aWidth += theLayer->mSpacing;
+		if (i > 0)
+		{
+			auto aPrevItr = theLayer->mCharDataMap.find(aPrevKey);
+			if (aPrevItr != theLayer->mCharDataMap.end())
+			{
+				auto aKern = aPrevItr->second.mKerningOffsets.find(aKey);
+				if (aKern != aPrevItr->second.mKerningOffsets.end())
