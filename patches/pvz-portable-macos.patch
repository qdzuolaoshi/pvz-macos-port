+			anEvent.type = SDL_KEYUP;
+			anEvent.key.state = SDL_RELEASED;
+			SDL_PushEvent(&anEvent);
+			return;
+		}
+		else if (aCmd == "logstate")
+		{
+			int aW = 0, aH = 0;
+			Uint32 aFlags = 0;
+			if (theApp->mWindow != nullptr)
+			{
+				SDL_GetWindowSize((SDL_Window*)theApp->mWindow, &aW, &aH);
+				aFlags = SDL_GetWindowFlags((SDL_Window*)theApp->mWindow);
+			}
+			int aDrawW = 0, aDrawH = 0;
+			if (theApp->mWindow != nullptr)
+				SDL_GL_GetDrawableSize((SDL_Window*)theApp->mWindow, &aDrawW, &aDrawH);
+			const GLInterface* anInterface = theApp->mGLInterface.get();
+			const Rect& aPresent = anInterface->mPresentationRect;
+			const Rect& aMouse = theApp->mWidgetManager->mMouseSourceRect;
+			GLint aViewport[4] = { 0, 0, 0, 0 };
+			glGetIntegerv(GL_VIEWPORT, aViewport); // as used by this frame's last batch
+			float anArea = 0, aBudget = 0;
+			bool anEconomy = false;
+			long anEconomyFrames = 0;
+			GLInterface::GetCubicBudgetState(anArea, aBudget, anEconomy, anEconomyFrames);
+			SDL_Log("PVZP_TEST state windowed=%d sdlFullscreen=%d window=%dx%d drawable=%dx%d present=%d,%d,%dx%d "
+				"glViewport=%d,%d,%dx%d mouseRect=%d,%d,%dx%d scale=%.4f filter=%s cubicMpx=%.2f budgetMpx=%.2f "
+				"economy=%d", theApp->mIsWindowed ? 1 : 0,
+				(aFlags & SDL_WINDOW_FULLSCREEN) != 0 ? 1 : 0, aW, aH, aDrawW, aDrawH,
+				aPresent.mX, aPresent.mY, aPresent.mWidth, aPresent.mHeight,
+				aViewport[0], aViewport[1], aViewport[2], aViewport[3],
+				aMouse.mX, aMouse.mY, aMouse.mWidth, aMouse.mHeight, anInterface->mPresentationScale, GLInterface::GetFilterName(),
+				anArea / 1.0e6f, aBudget / 1.0e6f, anEconomy ? 1 : 0);
+		}
+		else if (aCmd == "quit")
+		{
+			theApp->Shutdown();
+			return;
+		}
+	}
+}
+
+}
