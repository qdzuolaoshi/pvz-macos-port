diff --git a/src/SexyAppFramework/platform/default/MacWindowAspect.h b/src/SexyAppFramework/platform/default/MacWindowAspect.h
new file mode 100644
index 0000000..9d0fa82
--- /dev/null
+++ b/src/SexyAppFramework/platform/default/MacWindowAspect.h
@@ -0,0 +1,38 @@
+/*
+ * Windowed 4:3 aspect lock for the macOS game window (implementation: MacWindowAspect.mm).
+ *
+ * SPDX-License-Identifier: LGPL-3.0-or-later
+ */
+
+#ifndef __PVZP_MAC_WINDOW_ASPECT_H__
+#define __PVZP_MAC_WINDOW_ASPECT_H__
+
+#if defined(__APPLE__) && !defined(__IPHONEOS__)
+
+namespace Sexy
+{
+
+// Attach the lock to the SDL window once it exists. theMinWidth x theMinHeight (points) is the smallest window
+// content; it is rounded up to a 4:3 size. theLocked: the window is windowed (false while it is or goes fullscreen).
+void MacWindowAspectInstall(void* theSDLWindow, int theMinWidth, int theMinHeight, bool theLocked);
+
+// The game switched between windowed (true) and fullscreen (false). Call with false before a fullscreen request so
+// that no aspect constraint is left on the window while AppKit computes the fullscreen frame.
+void MacWindowAspectSetLocked(bool theLocked);
+
+// Once per input pump: when the window size has settled at a size that is not an exact 4:3 multiple of 4x3 points
+// (a programmatic size, tiling, a display change), resize it to one. theWindowed: the game is windowed and SDL does
+// not report fullscreen. Returns true when the window size was changed.
+bool MacWindowAspectUpdate(bool theWindowed);
+
+// Set the window content size (points) like SDL_SetWindowSize, for a window that AppKit regards as zoomed (it is at
+// its zoomed frame, also after a snap to the largest 4:3 size), whose size SDL would leave unchanged. Returns false
+// when SDL_SetWindowSize is to be used instead (not zoomed, fullscreen, no Cocoa window). Call it before a following
+// SDL_SetWindowPosition.
+bool MacWindowAspectSetContentSize(int theWidth, int theHeight);
+
+}
+
+#endif
+
+#endif
diff --git a/src/SexyAppFramework/platform/default/MacWindowAspect.mm b/src/SexyAppFramework/platform/default/MacWindowAspect.mm
new file mode 100644
index 0000000..ad48942
--- /dev/null
+++ b/src/SexyAppFramework/platform/default/MacWindowAspect.mm
@@ -0,0 +1,647 @@
+/*
+ * Windowed 4:3 aspect lock for the macOS game window.
+ *
+ * In windowed mode the window content is kept at (4k x 3k) points for an integer k. Such a size is exactly 4:3 and
+ * its drawable (8k x 6k pixels on a 2x Retina display) is too, so GLInterface::UpdateViewport fills it with no
+ * letterbox bar at all.
+ *
+ *  - Live resizing by the user (dragging an edge or a corner): NSWindow.contentAspectRatio = 4:3 makes AppKit propose
+ *    4:3 sizes, and SDL's window delegate method windowWillResize:toSize: is wrapped (runtime method replacement on
+ *    SDL's delegate class) so that every proposed size is rounded to the nearest 4k x 3k and clamped between the
+ *    minimum and the largest size that fits the visible area of the screen. SDL3's own windowWillResize:toSize: only
+ *    enforces SDL_SetWindowAspectRatio limits, which sdl2-compat never sets (min_aspect == max_aspect == 0, so it
+ *    returns the proposal unchanged); it runs first and this lock has the last word.
+ *  - Zoom (double-clicking the title bar, Option-clicking the green button): windowWillUseStandardFrame:defaultFrame:
+ *    returns the largest 4k x 3k window inside the default zoomed frame, so zooming and unzooming both stay 4:3.
+ *    windowShouldZoom:toFrame: makes unzooming return to the last windowed 4:3 frame that was not zoomed, also when
+ *    the window reached the zoomed frame without a zoom (a snap to the largest size), where AppKit has no frame of
+ *    its own to return to. SDL ignores SDL_SetWindowSize while AppKit reports the window as zoomed, so the game's
+ *    own size requests go through MacWindowAspectSetContentSize, which then sets the frame directly.
+ *  - Any other size change (SDL_SetWindowSize, window tiling, other apps resizing the window, a display change):
+ *    once the size has been stable for kSettleSeconds, no mouse button is down and no live resize is running,
+ *    MacWindowAspectUpdate() resizes the window to 4:3 directly with -[NSWindow setFrame:display:] (SDL ignores
+ *    SDL_SetWindowSize while a window is zoomed) and keeps it inside the visible area. It keeps the dimension that
+ *    changed; when both changed, the larger one, except for a frame flush with two edges of the visible area (a tile
+ *    placed by window tiling or a window manager), which the window then fits inside. SDL follows through its
+ *    windowDidResize: handler. A size that comes back unchanged after two attempts is left alone for a while (1 s,
+ *    then 2, 4, ... 32 s, one snap each time, then until the size changes), so the lock never keeps fighting another
+ *    program, and a window left with bars that way is still snapped once nothing puts the size back any more.
+ *  - Fullscreen: the constraint is removed before a fullscreen request and during fullscreen transitions, and is
+ *    restored once the window is windowed again.
+ *  - Scripted tests: PVZP_TEST_NO_ASPECT_LOCK=1 (honoured only with PVZP_TEST_SCRIPT) turns the lock off.
+ *
+ * SPDX-License-Identifier: LGPL-3.0-or-later
+ */
+
+#import <AppKit/AppKit.h>
+#include <objc/runtime.h>
+
+#include <SDL.h>
+#include <SDL_syswm.h>
+
+#include <algorithm>
+#include <climits>
+#include <cmath>
+#include <cstdlib>
+
+#include "MacWindowAspect.h"
+
+namespace
+{
+
+constexpr int kUnitWidth = 4;		// window content = (kUnitWidth * k) x (kUnitHeight * k) points
+constexpr int kUnitHeight = 3;
+constexpr double kSettleSeconds = 0.15;	// a programmatic / system size must be stable this long before it is snapped
+constexpr int kMaxAttemptsPerSize = 2;	// snaps from one size within kAttemptWindowSeconds
+constexpr double kAttemptWindowSeconds = 3.0;
+constexpr double kFirstRetrySeconds = 1.0;	// a size left alone by the guard above is tried again after this, doubling
+constexpr int kMaxRetries = 6;				// 1 + 2 + ... + 32 s; then left alone until the size changes
+constexpr double kTransitionTimeoutSeconds = 4.0;	// fullscreen animations take about one second
+
+using WillResizeFn = NSSize (*)(id, SEL, NSWindow*, NSSize);
+using StandardFrameFn = NSRect (*)(id, SEL, NSWindow*, NSRect);
+using ShouldZoomFn = BOOL (*)(id, SEL, NSWindow*, NSRect);
+
+NSWindow* gWindow = nil;			// not retained: SDL owns it (cleared on NSWindowWillCloseNotification)
+id gObserver = nil;
+bool gLocked = false;				// the game is windowed (MacWindowAspectSetLocked)
+bool gSDLWindowed = true;			// ... and SDL does not report fullscreen (MacWindowAspectUpdate)
+bool gFullscreenTransition = false;	// between NSWindowWill... and NSWindowDid...FullScreen
+double gTransitionStart = 0;
+bool gConstraintOn = false;			// contentAspectRatio is set
+int gMinK = 100;
+bool gPending = false;				// the size changed and has not been checked yet
+double gPendingSince = 0;
+NSSize gSettled = { 0, 0 };			// the last exact 4:3 content size seen
+NSSize gAttemptFrom = { 0, 0 };		// the non-4:3 size the last snap started from
+int gAttempts = 0;
+double gLastAttemptTime = 0;
+double gRetryAt = 0;				// the size the guard left alone is snapped again at this time (0: no retry due)
+double gRetryDelay = kFirstRetrySeconds;
+int gRetries = 0;
+NSRect gUserFrame = { { 0, 0 }, { 0, 0 } };	// the last settled windowed 4:3 frame that was not zoomed (unzoom target)
+bool gLog = false;
+bool gHooksInstalled = false;
+WillResizeFn gOrigWillResize = nullptr;
+StandardFrameFn gOrigStandardFrame = nullptr;
+ShouldZoomFn gOrigShouldZoom = nullptr;
+
+bool InFullscreenTransition()
+{
+	// A transition that failed posts no notification (only the delegate hears of it): give up waiting after a while.
+	return gFullscreenTransition && CFAbsoluteTimeGetCurrent() - gTransitionStart < kTransitionTimeoutSeconds;
+}
+
+// Test only: PVZP_TEST_NO_ASPECT_LOCK=1 in a scripted test run (PVZP_TEST_SCRIPT set) never locks the window, so a
+// test window of a fullscreen ratio (e.g. "winsize 1280 800") shows the pillarboxed 4:3 picture that fullscreen shows.
+bool TestNoAspectLock()
+{
+	static const bool sOn = [] {
+		const char* aValue = std::getenv("PVZP_TEST_NO_ASPECT_LOCK");
+		return aValue != nullptr && std::atoi(aValue) != 0 && std::getenv("PVZP_TEST_SCRIPT") != nullptr;
+	}();
+	return sOn;
+}
+
+bool LockActive(NSWindow* theWindow)
+{
+	if (theWindow == nil || theWindow != gWindow || !gLocked || !gSDLWindowed || InFullscreenTransition())
+		return false;
+	const NSWindowStyleMask aStyle = [theWindow styleMask];
+	return (aStyle & NSWindowStyleMaskFullScreen) == 0 && (aStyle & NSWindowStyleMaskResizable) != 0;
+}
+
+bool IsExact43(NSSize theSize)
+{
+	const double aK = std::round(theSize.width / kUnitWidth);
+	return aK >= 1 && std::fabs(theSize.width - aK * kUnitWidth) < 1e-3 && std::fabs(theSize.height - aK * kUnitHeight) < 1e-3;
+}
+
+// The largest k whose window (content plus title bar / frame) fits the visible area of theScreen.
+int MaxK(NSWindow* theWindow, NSScreen* theScreen)
+{
+	if (theScreen == nil)
+		theScreen = [NSScreen mainScreen];
+	if (theScreen == nil)
+		return INT_MAX / (kUnitWidth * 2);
+	const NSRect aVisible = [theScreen visibleFrame];
+	const NSRect aFrame = [theWindow frame];
+	const NSRect aContent = [theWindow contentRectForFrameRect:aFrame];
+	const double aExtraW = aFrame.size.width - aContent.size.width;
+	const double aExtraH = aFrame.size.height - aContent.size.height;
+	const int aK = (int)std::floor(std::min((aVisible.size.width - aExtraW) / kUnitWidth, (aVisible.size.height - aExtraH) / kUnitHeight));
+	return std::max(aK, gMinK);
+}
+
+NSSize ContentSizeForK(int theK)
+{
+	return NSMakeSize(theK * kUnitWidth, theK * kUnitHeight);
+}
+
+void MarkPending()
+{
+	gPending = true;
+	gPendingSince = CFAbsoluteTimeGetCurrent();
+}
+
+// Move theFrame inside theVisible (the visible area of a screen), keeping its size.
+NSRect ClampToVisible(NSRect theFrame, NSRect theVisible)
+{
+	if (NSMaxX(theFrame) > NSMaxX(theVisible))
+		theFrame.origin.x = NSMaxX(theVisible) - theFrame.size.width;
+	if (theFrame.origin.x < NSMinX(theVisible))
+		theFrame.origin.x = NSMinX(theVisible);
+	if (NSMaxY(theFrame) > NSMaxY(theVisible))
+		theFrame.origin.y = NSMaxY(theVisible) - theFrame.size.height;
+	if (theFrame.origin.y < NSMinY(theVisible))
+		theFrame.origin.y = NSMinY(theVisible);
+	return theFrame;
+}
+
+// A windowed, settled, exact 4:3 frame that is not AppKit's zoomed frame is where unzooming returns to.
+void RememberUserFrame(NSWindow* theWindow)
+{
+	if (!LockActive(theWindow) || [theWindow inLiveResize] || [theWindow isZoomed])
+		return;
+	const NSRect aFrame = [theWindow frame];
+	if (IsExact43([theWindow contentRectForFrameRect:aFrame].size))
+		gUserFrame = aFrame;
+}
+
+// Put the AppKit live-resize constraint on the window while it is windowed, and take it off otherwise.
+void ApplyConstraint()
+{
+	if (gWindow == nil)
+		return;
+	gConstraintOn = LockActive(gWindow);
+	if (gConstraintOn)
+	{
+		if (!NSEqualSizes([gWindow contentAspectRatio], NSMakeSize(kUnitWidth, kUnitHeight)))
+		{
+			[gWindow setContentAspectRatio:NSMakeSize(kUnitWidth, kUnitHeight)];
+			if (gLog)
+				SDL_Log("PVZP_ASPECT constraint on (contentAspectRatio %gx%g)", [gWindow contentAspectRatio].width, [gWindow contentAspectRatio].height);
+		}
+	}
+	else if (!NSEqualSizes([gWindow contentAspectRatio], NSZeroSize))
+	{
+		// contentResizeIncrements and contentAspectRatio are mutually exclusive: 1x1 increments clear the ratio.
+		[gWindow setContentResizeIncrements:NSMakeSize(1, 1)];
+		if (!NSEqualSizes([gWindow contentAspectRatio], NSZeroSize))
+			[gWindow setContentAspectRatio:NSZeroSize];
+		if (gLog)
+			SDL_Log("PVZP_ASPECT constraint off (contentAspectRatio %gx%g)", [gWindow contentAspectRatio].width, [gWindow contentAspectRatio].height);
+	}
+}
+
+// Live resize: round every size AppKit proposes to the nearest 4k x 3k.
+NSSize PvzpWindowWillResize(id self, SEL _cmd, NSWindow* sender, NSSize frameSize)
+{
+	NSSize aSize = gOrigWillResize != nullptr ? gOrigWillResize(self, _cmd, sender, frameSize) : frameSize;
+	if (!LockActive(sender))
+		return aSize;
+
+	const NSRect aCurrent = [sender contentRectForFrameRect:[sender frame]];
+	const NSRect aProposed = [sender contentRectForFrameRect:NSMakeRect(0, 0, aSize.width, aSize.height)];
+	const double aKW = aProposed.size.width / kUnitWidth;
+	const double aKH = aProposed.size.height / kUnitHeight;
+	// Follow the dimension being dragged (the one that changed more, in 4:3 units); a corner drag, or AppKit's
+	// aspect ratio, moves both, and then their mean is used.
+	const double aDW = std::fabs(aProposed.size.width - aCurrent.size.width) / kUnitWidth;
+	const double aDH = std::fabs(aProposed.size.height - aCurrent.size.height) / kUnitHeight;
+	const double aK = aDW > aDH + 0.5 ? aKW : (aDH > aDW + 0.5 ? aKH : (aKW + aKH) / 2);
+	const int aKInt = std::clamp((int)std::lround(aK), gMinK, MaxK(sender, [sender screen]));
+
+	const NSSize aContent = ContentSizeForK(aKInt);
+	return [sender frameRectForContentRect:NSMakeRect(0, 0, aContent.width, aContent.height)].size;
+}
+
+// Zoom: the largest 4k x 3k window inside the default zoomed frame (which AppKit already fits to the aspect ratio,
+// at the left edge of the screen), top-aligned and centred horizontally on the visible area of the screen.
+NSRect PvzpWindowWillUseStandardFrame(id self, SEL _cmd, NSWindow* sender, NSRect defaultFrame)
+{
+	NSRect aFrame = gOrigStandardFrame != nullptr ? gOrigStandardFrame(self, _cmd, sender, defaultFrame) : defaultFrame;
+	if (!LockActive(sender))
+		return aFrame;
+
+	const NSRect aContent = [sender contentRectForFrameRect:aFrame];
+	const int aK = std::max(gMinK, (int)std::floor(std::min(aContent.size.width / kUnitWidth, aContent.size.height / kUnitHeight)));
+	const NSSize aSize = ContentSizeForK(aK);
+	NSRect aResult = [sender frameRectForContentRect:NSMakeRect(0, 0, aSize.width, aSize.height)];
+	NSRect aBounds = aFrame;
+	NSScreen* aScreen = [sender screen];
+	if (aScreen != nil && NSContainsRect([aScreen visibleFrame], aFrame))
+		aBounds = [aScreen visibleFrame];
+	aResult.origin.x = std::round(NSMidX(aBounds) - aResult.size.width / 2);
+	aResult.origin.y = NSMaxY(aFrame) - aResult.size.height;
+	return aResult;
+}
+
+// Zoom and unzoom. Zooming in: remember the frame to come back to. Unzooming: return to the last windowed 4:3 frame
+// that was not zoomed (AppKit would return to the frame it saved when it last zoomed the window, and a window that
+// reached the zoomed frame without a zoom, such as a snap to the largest size, has none: AppKit then picks a size
+// near the zoomed one).
+BOOL PvzpWindowShouldZoom(id self, SEL _cmd, NSWindow* sender, NSRect newFrame)
+{
+	const BOOL aZoom = gOrigShouldZoom != nullptr ? gOrigShouldZoom(self, _cmd, sender, newFrame) : YES;
+	if (!aZoom || !LockActive(sender))
+		return aZoom;
+	if (![sender isZoomed])
+	{
+		RememberUserFrame(sender);
+		return YES;
+	}
+	if (NSIsEmptyRect(gUserFrame))
+		return YES;
+	NSRect aTarget = gUserFrame;
+	NSScreen* aScreen = [sender screen];
+	if (aScreen != nil)
+	{
+		// The screen may have changed since: keep the size if it still fits, else the largest that does.
+		const NSRect aVisible = [aScreen visibleFrame];
+		const NSRect aContent = [sender contentRectForFrameRect:aTarget];
+		const int aK = std::clamp((int)std::lround(aContent.size.width / kUnitWidth), gMinK, MaxK(sender, aScreen));
+		const NSSize aSize = ContentSizeForK(aK);
+		const NSRect aSized = [sender frameRectForContentRect:NSMakeRect(0, 0, aSize.width, aSize.height)];
+		aTarget.origin.y = NSMaxY(aTarget) - aSized.size.height;
+		aTarget.size = aSized.size;
+		aTarget = ClampToVisible(aTarget, aVisible);
+	}
+	if (NSEqualRects(aTarget, [sender frame]))
+		return YES;
+	[sender setFrame:aTarget display:YES];
+	if (gLog)
+		SDL_Log("PVZP_ASPECT unzoom to %gx%g at %g,%g", [sender contentRectForFrameRect:aTarget].size.width,
+			[sender contentRectForFrameRect:aTarget].size.height, aTarget.origin.x, aTarget.origin.y);
+	return NO;
+}
+
+const char* DelegateMethodTypes(SEL theSelector, Method theExisting)
+{
+	if (theExisting != nullptr)
+		return method_getTypeEncoding(theExisting);
+	struct objc_method_description aDesc = protocol_getMethodDescription(@protocol(NSWindowDelegate), theSelector, NO, YES);
+	return aDesc.types;
+}
+
+void InstallDelegateHooks(NSWindow* theWindow)
+{
+	if (gHooksInstalled)
+		return;
+	id aDelegate = [theWindow delegate];
+	if (aDelegate == nil)
+	{
+		SDL_Log("PVZP_ASPECT the window has no delegate; live resizing relies on contentAspectRatio alone");
+		return;
+	}
+	Class aClass = [aDelegate class];
+
+	const SEL aResizeSel = @selector(windowWillResize:toSize:);
+	Method aResize = class_getInstanceMethod(aClass, aResizeSel);
+	const char* aResizeTypes = DelegateMethodTypes(aResizeSel, aResize);
+	const SEL aZoomSel = @selector(windowWillUseStandardFrame:defaultFrame:);
+	Method aZoom = class_getInstanceMethod(aClass, aZoomSel);
+	const char* aZoomTypes = DelegateMethodTypes(aZoomSel, aZoom);
+	const SEL aShouldZoomSel = @selector(windowShouldZoom:toFrame:);
+	Method aShouldZoom = class_getInstanceMethod(aClass, aShouldZoomSel);
+	const char* aShouldZoomTypes = DelegateMethodTypes(aShouldZoomSel, aShouldZoom);
+	if (aResizeTypes == nullptr || aZoomTypes == nullptr || aShouldZoomTypes == nullptr)
+	{
+		SDL_Log("PVZP_ASPECT no NSWindowDelegate method types; live resizing relies on contentAspectRatio alone");
+		return;
+	}
+
+	gOrigWillResize = aResize != nullptr ? (WillResizeFn)method_getImplementation(aResize) : nullptr;
+	gOrigStandardFrame = aZoom != nullptr ? (StandardFrameFn)method_getImplementation(aZoom) : nullptr;
+	gOrigShouldZoom = aShouldZoom != nullptr ? (ShouldZoomFn)method_getImplementation(aShouldZoom) : nullptr;
+	class_replaceMethod(aClass, aResizeSel, (IMP)PvzpWindowWillResize, aResizeTypes);
+	class_replaceMethod(aClass, aZoomSel, (IMP)PvzpWindowWillUseStandardFrame, aZoomTypes);
+	class_replaceMethod(aClass, aShouldZoomSel, (IMP)PvzpWindowShouldZoom, aShouldZoomTypes);
+	gHooksInstalled = true;
+
+	// A delegate method added at run time is only seen once AppKit re-reads what the delegate implements.
+	if (aResize == nullptr || aZoom == nullptr || aShouldZoom == nullptr)
+	{
+		[theWindow setDelegate:nil];
+		[theWindow setDelegate:aDelegate];
+	}
+
+	if (gLog)
+		SDL_Log("PVZP_ASPECT hooks on %s (windowWillResize:toSize: %s, windowWillUseStandardFrame:defaultFrame: %s, "
+			"windowShouldZoom:toFrame: %s)", class_getName(aClass), aResize != nullptr ? "wrapped" : "added",
+			aZoom != nullptr ? "wrapped" : "added", aShouldZoom != nullptr ? "wrapped" : "added");
+}
+
+// Resize a window whose size settled at a non-4:3 size (or larger than the visible area) to 4k x 3k.
+bool Snap()
+{
+	NSWindow* aWindow = gWindow;
+	const NSRect aFrame = [aWindow frame];
+	const NSRect aContent = [aWindow contentRectForFrameRect:aFrame];
+	const double aW = aContent.size.width, aH = aContent.size.height;
+	NSScreen* aScreen = [aWindow screen];
+	if (aScreen == nil)
+		aScreen = [NSScreen mainScreen];
+	const int aKMax = MaxK(aWindow, aScreen);
+
+	const bool anExact = IsExact43(aContent.size);
+	const int anExactK = anExact ? (int)std::lround(aW / kUnitWidth) : 0;
+	if (anExact && anExactK >= gMinK && anExactK <= aKMax)
+	{
+		gSettled = aContent.size;
+		RememberUserFrame(aWindow);
+		return false;
+	}
+
+	// A frame flush with two or more edges of the visible area was placed there by window tiling or a window manager.
+	const NSRect aVisible = aScreen != nil ? [aScreen visibleFrame] : NSZeroRect;
+	const bool aAtLeft = aScreen != nil && std::fabs(NSMinX(aFrame) - NSMinX(aVisible)) <= 1;
+	const bool aAtRight = aScreen != nil && std::fabs(NSMaxX(aFrame) - NSMaxX(aVisible)) <= 1;
+	const bool aAtBottom = aScreen != nil && std::fabs(NSMinY(aFrame) - NSMinY(aVisible)) <= 1;
+	const bool aAtTop = aScreen != nil && std::fabs(NSMaxY(aFrame) - NSMaxY(aVisible)) <= 1;
+	bool aFitTile = false;
+
+	int aK;
+	if (anExact)
+		aK = anExactK;
+	else
+	{
+		// Keep the dimension that was changed; when both were, keep the larger one (relative to 4:3), except in a
+		// tile, which the window then fits inside.
+		const bool aWidthChanged = std::fabs(aW - gSettled.width) >= 0.5;
+		const bool aHeightChanged = std::fabs(aH - gSettled.height) >= 0.5;
+		if (aWidthChanged && !aHeightChanged)
+			aK = (int)std::lround(aW / kUnitWidth);
+		else if (aHeightChanged && !aWidthChanged)
+			aK = (int)std::lround(aH / kUnitHeight);
+		else if ((int)aAtLeft + (int)aAtRight + (int)aAtBottom + (int)aAtTop >= 2)
+		{
+			aFitTile = true;
+			aK = (int)std::floor(std::min(aW / kUnitWidth, aH / kUnitHeight));
+		}
+		else
+			aK = (int)std::lround(std::max(aW / kUnitWidth, aH / kUnitHeight));
+	}
+	aK = std::clamp(aK, gMinK, aKMax);
+
+	// Something that puts the same size back right after each snap (a window manager enforcing a tile) wins after
+	// kMaxAttemptsPerSize snaps, so the two never alternate. The size is then tried once more after a pause that
+	// doubles each time (MacWindowAspectUpdate), so that bars do not stay once nothing puts the size back any more.
+	const double aNowTime = CFAbsoluteTimeGetCurrent();
+	if (NSEqualSizes(aContent.size, gAttemptFrom) && aNowTime - gLastAttemptTime < kAttemptWindowSeconds)
+	{
+		if (gAttempts >= kMaxAttemptsPerSize)
+		{
+			if (gRetries < kMaxRetries)
+			{
+				gRetryAt = aNowTime + gRetryDelay;
+				if (gLog)
+					SDL_Log("PVZP_ASPECT %gx%g keeps coming back: left as it is, trying again in %gs", aW, aH, gRetryDelay);
+				gRetryDelay *= 2;
+				gRetries++;
+			}
+			else if (gLog)
+				SDL_Log("PVZP_ASPECT %gx%g keeps coming back: left as it is until the size changes", aW, aH);
+			return false;
+		}
+		gAttempts++;
+	}
+	else
+	{
+		// A new size; after a quiet period the backoff of an earlier fight starts over as well.
+		if (aNowTime - gLastAttemptTime >= kAttemptWindowSeconds)
+		{
+			gRetries = 0;
+			gRetryDelay = kFirstRetrySeconds;
+		}
+		gAttemptFrom = aContent.size;
+		gAttempts = 1;
+	}
+	gLastAttemptTime = aNowTime;
+	gRetryAt = 0;
+
+	// Keep the top edge and the horizontal centre (in a tile: the tile edges it is flush with), then keep the window
+	// inside the visible area of its screen.
+	const NSSize aSize = ContentSizeForK(aK);
+	NSRect aTarget = [aWindow frameRectForContentRect:NSMakeRect(0, 0, aSize.width, aSize.height)];
+	aTarget.origin.x = std::round(NSMidX(aFrame) - aTarget.size.width / 2);
+	aTarget.origin.y = NSMaxY(aFrame) - aTarget.size.height;
+	if (aFitTile)
+	{
+		if (aAtLeft && !aAtRight)
+			aTarget.origin.x = NSMinX(aFrame);
+		else if (aAtRight && !aAtLeft)
+			aTarget.origin.x = NSMaxX(aFrame) - aTarget.size.width;
+		if (aAtBottom && !aAtTop)
+			aTarget.origin.y = NSMinY(aFrame);
+	}
+	if (aScreen != nil)
+		aTarget = ClampToVisible(aTarget, aVisible);
+
+	[aWindow setFrame:aTarget display:YES];
+
+	const NSRect aNow = [aWindow contentRectForFrameRect:[aWindow frame]];
+	if (IsExact43(aNow.size))
+		gSettled = aNow.size;
+	if (gLog)
+		SDL_Log("PVZP_ASPECT snap %gx%g -> %gx%g (k=%d, max %d, %sattempt %d), now %gx%g", aW, aH, aSize.width, aSize.height,
+			aK, aKMax, aFitTile ? "tile, " : "", gAttempts, aNow.size.width, aNow.size.height);
+	return true;
+}
+
+void Detach()
+{
+	if (gObserver != nil)
+		[[NSNotificationCenter defaultCenter] removeObserver:gObserver];
+	gWindow = nil;
+	gPending = false;
+}
+
+}
+
+@interface PvzpMacAspectObserver : NSObject
+@end
+
+@implementation PvzpMacAspectObserver
+- (void)sizeChanged:(NSNotification*)theNotification
+{
+	(void)theNotification;
+	MarkPending();
+}
+- (void)willEnterOrExitFullScreen:(NSNotification*)theNotification
+{
+	(void)theNotification;
+	gFullscreenTransition = true;
+	gTransitionStart = CFAbsoluteTimeGetCurrent();
+	ApplyConstraint();
+}
+- (void)didEnterFullScreen:(NSNotification*)theNotification
+{
+	(void)theNotification;
+	gFullscreenTransition = false;
+	ApplyConstraint();
+}
+- (void)didExitFullScreen:(NSNotification*)theNotification
+{
+	(void)theNotification;
+	gFullscreenTransition = false;
+	ApplyConstraint();
+	MarkPending();
+}
+- (void)windowWillClose:(NSNotification*)theNotification
+{
+	(void)theNotification;
+	Detach();
+}
+@end
+
+namespace Sexy
+{
+
+void MacWindowAspectInstall(void* theSDLWindow, int theMinWidth, int theMinHeight, bool theLocked)
+{
+	@autoreleasepool
+	{
+		gLog = std::getenv("PVZP_ASPECT_LOG") != nullptr || std::getenv("PVZP_TEST_SCRIPT") != nullptr;
+		if (theSDLWindow == nullptr)
+			return;
+
+		SDL_SysWMinfo anInfo;
+		SDL_VERSION(&anInfo.version);
+		if (!SDL_GetWindowWMInfo((SDL_Window*)theSDLWindow, &anInfo) || anInfo.subsystem != SDL_SYSWM_COCOA ||
+			anInfo.info.cocoa.window == nil)
+		{
+			SDL_Log("PVZP_ASPECT unavailable: no Cocoa window (%s)", SDL_GetError());
+			return;
+		}
+		NSWindow* aWindow = anInfo.info.cocoa.window;
+
+		gMinK = std::max({ 1, (theMinWidth + kUnitWidth - 1) / kUnitWidth, (theMinHeight + kUnitHeight - 1) / kUnitHeight });
+		SDL_SetWindowMinimumSize((SDL_Window*)theSDLWindow, gMinK * kUnitWidth, gMinK * kUnitHeight);
+
+		if (gWindow != aWindow)
+		{
+			Detach();
+			gWindow = aWindow;
+			if (gObserver == nil)
+				gObserver = [[PvzpMacAspectObserver alloc] init];
+			NSNotificationCenter* aCenter = [NSNotificationCenter defaultCenter];
+			[aCenter addObserver:gObserver selector:@selector(sizeChanged:) name:NSWindowDidResizeNotification object:aWindow];
+			[aCenter addObserver:gObserver selector:@selector(sizeChanged:) name:NSWindowDidEndLiveResizeNotification object:aWindow];
+			// A move only changes the frame that unzooming returns to (RememberUserFrame, once it has settled).
+			[aCenter addObserver:gObserver selector:@selector(sizeChanged:) name:NSWindowDidMoveNotification object:aWindow];
+			[aCenter addObserver:gObserver selector:@selector(sizeChanged:) name:NSWindowDidChangeScreenNotification object:aWindow];
+			[aCenter addObserver:gObserver selector:@selector(sizeChanged:) name:NSApplicationDidChangeScreenParametersNotification object:nil];
+			[aCenter addObserver:gObserver selector:@selector(willEnterOrExitFullScreen:) name:NSWindowWillEnterFullScreenNotification object:aWindow];
+			[aCenter addObserver:gObserver selector:@selector(willEnterOrExitFullScreen:) name:NSWindowWillExitFullScreenNotification object:aWindow];
+			[aCenter addObserver:gObserver selector:@selector(didEnterFullScreen:) name:NSWindowDidEnterFullScreenNotification object:aWindow];
+			[aCenter addObserver:gObserver selector:@selector(didExitFullScreen:) name:NSWindowDidExitFullScreenNotification object:aWindow];
+			[aCenter addObserver:gObserver selector:@selector(windowWillClose:) name:NSWindowWillCloseNotification object:aWindow];
+		}
+
+		InstallDelegateHooks(aWindow);
+
+		gLocked = theLocked && !TestNoAspectLock();
+		gSDLWindowed = theLocked;
+		gFullscreenTransition = false;
+		const NSSize aContent = [aWindow contentRectForFrameRect:[aWindow frame]].size;
+		gSettled = IsExact43(aContent) ? aContent : NSZeroSize;
+		gAttempts = 0;
+		gAttemptFrom = NSZeroSize;
+		gRetryAt = 0;
+		gRetries = 0;
+		gRetryDelay = kFirstRetrySeconds;
+		gUserFrame = NSZeroRect;
+		ApplyConstraint();
+		MarkPending();
+		if (gLog)
+			SDL_Log("PVZP_ASPECT installed: content %gx%g, min %dx%d, locked %d%s", aContent.width, aContent.height,
+				gMinK * kUnitWidth, gMinK * kUnitHeight, gLocked ? 1 : 0,
+				TestNoAspectLock() ? " (PVZP_TEST_NO_ASPECT_LOCK: never locked)" : "");
+	}
+}
+
+void MacWindowAspectSetLocked(bool theLocked)
+{
+	if (TestNoAspectLock())
+		theLocked = false;
+	if (gLocked == theLocked)
+		return;
+	@autoreleasepool
+	{
+		gLocked = theLocked;
+		ApplyConstraint();
+		if (theLocked)
+			MarkPending();
+	}
+}
+
+bool MacWindowAspectUpdate(bool theWindowed)
+{
+	if (gWindow == nil)
+		return false;
+	gSDLWindowed = theWindowed;
+	const bool aLockActive = LockActive(gWindow);
+	if (aLockActive != gConstraintOn && ![gWindow inLiveResize])
+	{
+		// The lock changed without a notification (the screen mode, or a fullscreen transition that failed).
+		@autoreleasepool
+		{
+			ApplyConstraint();
+		}
+	}
+	if (gRetryAt > 0 && !gPending && CFAbsoluteTimeGetCurrent() >= gRetryAt)
+	{
+		// The pause after the oscillation guard is over: one more snap from the size it left alone. If the size is put
+		// back again at once, the guard stops it with the next, longer pause.
+		gRetryAt = 0;
+		gAttempts = kMaxAttemptsPerSize - 1;
+		gLastAttemptTime = CFAbsoluteTimeGetCurrent();
+		gPending = true;
+		gPendingSince = gLastAttemptTime - kSettleSeconds;
+	}
+	if (!gPending)
+		return false;
+	@autoreleasepool
+	{
+		if (!aLockActive || [gWindow inLiveResize] || [gWindow isMiniaturized] || ![gWindow isVisible])
+			return false;
+		// A mouse button still down: the user may be moving the window (to a tile, to another display).
+		if ([NSEvent pressedMouseButtons] != 0)
+			return false;
+		if (CFAbsoluteTimeGetCurrent() - gPendingSince < kSettleSeconds)
+			return false;
+		gPending = false;
+		return Snap();
+	}
+}
+
+bool MacWindowAspectSetContentSize(int theWidth, int theHeight)
+{
+	if (gWindow == nil || theWidth <= 0 || theHeight <= 0 || InFullscreenTransition())
+		return false;
+	@autoreleasepool
+	{
+		const NSWindowStyleMask aStyle = [gWindow styleMask];
+		if ((aStyle & NSWindowStyleMaskFullScreen) != 0 || (aStyle & NSWindowStyleMaskResizable) == 0 || ![gWindow isZoomed])
+			return false; // SDL_SetWindowSize works
+		// AppKit regards the window as zoomed (it is at the zoomed frame), and SDL then ignores SDL_SetWindowSize: set
+		// the frame directly, keeping the top edge and the horizontal centre, inside the visible area. The window is
+		// no longer zoomed afterwards, and SDL follows through its windowDidResize: handler.
+		const NSRect aFrame = [gWindow frame];
+		NSRect aTarget = [gWindow frameRectForContentRect:NSMakeRect(0, 0, theWidth, theHeight)];
+		aTarget.origin.x = std::round(NSMidX(aFrame) - aTarget.size.width / 2);
+		aTarget.origin.y = NSMaxY(aFrame) - aTarget.size.height;
+		NSScreen* aScreen = [gWindow screen];
+		if (aScreen != nil)
+			aTarget = ClampToVisible(aTarget, [aScreen visibleFrame]);
+		[gWindow setFrame:aTarget display:YES];
+		if (gLog)
+			SDL_Log("PVZP_ASPECT size %dx%d requested while zoomed: frame set directly, now %gx%g (zoomed %d)", theWidth,
+				theHeight, [gWindow contentRectForFrameRect:[gWindow frame]].size.width,
+				[gWindow contentRectForFrameRect:[gWindow frame]].size.height, [gWindow isZoomed] ? 1 : 0);
+		return true;
+	}
+}
+
+}
