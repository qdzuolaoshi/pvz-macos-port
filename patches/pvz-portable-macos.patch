diff --git a/src/SexyAppFramework/misc/PvzpHitch.h b/src/SexyAppFramework/misc/PvzpHitch.h
new file mode 100644
index 0000000..d312d3b
--- /dev/null
+++ b/src/SexyAppFramework/misc/PvzpHitch.h
@@ -0,0 +1,107 @@
+/*
+ * Frame-hitch logger (macOS port test tooling; implementation in PvzpTestHook.cpp).
+ *
+ * Off unless the environment variable PVZP_HITCH_MS is set or a test script runs "hitchlog MS". While it is off,
+ * every hook below costs one branch on a global flag. While it is on, the main loop's phases (event pump, logic
+ * updates, draw, GPU submit, swap, sleep) are timed per presented frame, the main thread counts what happened in
+ * the frame (image decodes, texture creations, definition loads, sound decodes, glyph rasterisations, disk reads
+ * and writes, log lines), the frame's GPU time is measured with timer queries (macOS), and every frame whose
+ * interval exceeds the threshold is logged with that breakdown ("PVZP_HITCH frame ..."). Statistics (frames over
+ * 25/33/50/100 ms, phase means and maxima, an interval histogram, GPU time) are logged by the test command
+ * "hitchstats", or once a minute when PVZP_HITCH_MS is used without a test script (manual play).
+ *
+ * SPDX-License-Identifier: LGPL-3.0-or-later
+ */
+
+#ifndef __PVZPHITCH_H__
+#define __PVZPHITCH_H__
+
+#include <cstdint>
+#include <string_view>
+
+namespace Sexy
+{
+
+class SexyAppBase;
+
+enum PvzpHitchPhase
+{
+	HITCH_PHASE_EVENTS,		// ProcessDeferredMessages (SDL events, queued input)
+	HITCH_PHASE_UPDATE,		// DoUpdateFrames / DoUpdateFramesF (logic steps)
+	HITCH_PHASE_MUSIC,		// music interface update (part of UPDATE)
+	HITCH_PHASE_DRAW,		// WidgetManager::DrawScreen (draw calls, texture creation on first use)
+	HITCH_PHASE_PRESENT,	// SexyAppBase::Redraw: GPU submit (GfxFlush) and SDL_GL_SwapWindow
+	HITCH_PHASE_SLEEP,		// sleeps of the main loop (frame pacing, loading-time yield)
+	NUM_HITCH_PHASES
+};
+
+enum PvzpHitchCounter
+{
+	HITCH_IMAGE_DECODES, HITCH_IMAGE_DECODE_US, HITCH_IMAGE_KPIXELS,
+	HITCH_DEF_LOADS, HITCH_DEF_LOAD_US,
+	HITCH_DEF_CACHE_WRITES,
+	HITCH_SOUND_DECODES, HITCH_SOUND_DECODE_US,
+	HITCH_MUSIC_LOADS,
+	HITCH_GLYPHS, HITCH_GLYPH_US, HITCH_GLYPH_TRIMS,
+	HITCH_DISK_OPENS, HITCH_DISK_READ_BYTES,
+	HITCH_FILE_WRITES, HITCH_FILE_WRITE_US,
+	HITCH_LOG_LINES,
+	HITCH_RES_GROUPS,
+	NUM_HITCH_COUNTERS
+};
+
+extern bool gPvzpHitchOn;
+
+void		PvzpHitchCountSlow(PvzpHitchCounter theCounter, int64_t theAmount);
+void		PvzpHitchNoteSlow(const char* theKind, std::string_view theName);
+uint64_t	PvzpHitchTicks();
+void		PvzpHitchAddPhaseSlow(PvzpHitchPhase thePhase, uint64_t theStartTicks);
+void		PvzpHitchScopeEndSlow(PvzpHitchCounter theCountCounter, PvzpHitchCounter theTimeCounter, uint64_t theStartTicks);
+// End of a presented frame (after the swap): closes the frame's accounting and logs it when it is a hitch.
+void		PvzpHitchFrameEnd(SexyAppBase* theApp);
+
+// Counts on the main thread only; other threads (the loading thread) never stall a frame by themselves.
+inline void PvzpHitchCount(PvzpHitchCounter theCounter, int64_t theAmount = 1)
+{
+	if (gPvzpHitchOn)
+		PvzpHitchCountSlow(theCounter, theAmount);
+}
+
+// Records the name of something loaded in this frame (first few per frame are logged with a hitch).
+inline void PvzpHitchNote(const char* theKind, std::string_view theName)
+{
+	if (gPvzpHitchOn)
+		PvzpHitchNoteSlow(theKind, theName);
+}
+
+// Times a main-loop phase of the current frame.
+class PvzpHitchPhaseScope
+{
+public:
+	explicit PvzpHitchPhaseScope(PvzpHitchPhase thePhase) : mPhase(thePhase), mStart(gPvzpHitchOn ? PvzpHitchTicks() : 0) {}
+	~PvzpHitchPhaseScope() { if (mStart != 0) PvzpHitchAddPhaseSlow(mPhase, mStart); }
+	PvzpHitchPhaseScope(const PvzpHitchPhaseScope&) = delete;
+	PvzpHitchPhaseScope& operator=(const PvzpHitchPhaseScope&) = delete;
+private:
+	PvzpHitchPhase	mPhase;
+	uint64_t		mStart;
+};
+
+// Counts one event and its duration in microseconds (main thread only).
+class PvzpHitchScope
+{
+public:
+	PvzpHitchScope(PvzpHitchCounter theCountCounter, PvzpHitchCounter theTimeCounter) :
+		mCountCounter(theCountCounter), mTimeCounter(theTimeCounter), mStart(gPvzpHitchOn ? PvzpHitchTicks() : 0) {}
+	~PvzpHitchScope() { if (mStart != 0) PvzpHitchScopeEndSlow(mCountCounter, mTimeCounter, mStart); }
+	PvzpHitchScope(const PvzpHitchScope&) = delete;
+	PvzpHitchScope& operator=(const PvzpHitchScope&) = delete;
+private:
+	PvzpHitchCounter	mCountCounter;
+	PvzpHitchCounter	mTimeCounter;
+	uint64_t			mStart;
+};
+
+}
+
+#endif // __PVZPHITCH_H__
diff --git a/src/SexyAppFramework/misc/PvzpTestHook.cpp b/src/SexyAppFramework/misc/PvzpTestHook.cpp
new file mode 100644
index 0000000..708d102
--- /dev/null
+++ b/src/SexyAppFramework/misc/PvzpTestHook.cpp
@@ -0,0 +1,1062 @@
+/*
+ * Scripted test driver for automated verification (macOS port).
+ *
+ * Inactive unless the environment variable PVZP_TEST_SCRIPT names a text file. Commands run from
+ * GLInterface::Flush, at most one input command per presented frame. Input commands are queued and
+ * delivered by PvzpTestHookPumpInput() from ProcessDeferredMessages, like real SDL input, and the
+ * following command waits until they have been delivered:
+ *   wait N            skip N frames
+ *   ms N              wait N milliseconds of wall-clock time
+ *   waitsound NAME [MS]  wait until a sound whose file name contains NAME starts (e.g. "waitsound losemusic"), at
+ *                     most MS milliseconds (default 60000); logs "started" or "TIMEOUT". With PVZP_TEST_SOUNDLOG=1
+ *                     in the environment every sound start is logged ("PVZP_TEST sound <file>")
+ *   move X Y          mouse move (game coordinates, 800x600)
+ *   click X Y         left click        rclick X Y   right click
+ *   char C            KeyChar(C)        type TEXT    KeyChar for each character
+ *   keydown CODE      KeyDown(KeyCode CODE)
+ *   shot NAME         write the presented frame to $PVZP_TEST_SHOTDIR/NAME.png, at drawable resolution (the
+ *                     presentation rect in drawable pixels, e.g. 2000x1500 for a 1000x750-point Retina window)
+ *   shotlogical NAME  the same frame box-filtered down to the logical 800x600, for layout comparison with
+ *                     shots of the old point-sized drawable
+ *   shotfull NAME     the whole drawable, including the black bars beside (or above and below) the 4:3 picture
+ *   log TEXT          write TEXT to the log
+ *   osfullscreen 0|1  set SDL fullscreen directly, like the macOS green window button
+ *   sdlkey SYM MOD    push a real SDL key press (e.g. "sdlkey 13 256" = Option+Return)
+ *   winsize W H       set the window size to W x H points, centred on its display; the game's normal resize
+ *                     handling (UpdateViewport, WidgetManager::Resize) follows (macOS: through
+ *                     MacWindowAspectSetContentSize while AppKit regards the window as zoomed, as the game does).
+ *                     The windowed 4:3 lock then snaps a non-4:3 size to 4:3; with PVZP_TEST_NO_ASPECT_LOCK=1 in the
+ *                     environment the window keeps it, so e.g. "winsize 1280 800" shows the pillarboxed picture
+ *                     (plain black bars left and right) that a 16:10 fullscreen shows
+ *   winzoom 0|1      SDL_RestoreWindow / SDL_MaximizeWindow (macOS: AppKit zoom, as a title-bar double-click)
+ *   winframe X Y W H  set the window's outer frame (title bar included) in SDL global points, e.g. flush with the
+ *                     display's usable bounds to imitate tiling; logs the border sizes and the usable bounds (when
+ *                     SDL reports no border sizes, X Y W H is the content rect instead)
+ *   wmove X Y         push a real SDL mouse motion to the window point under logical position (X, Y), converted
+ *                     through the window-space presentation rect, so WidgetManager::RemapMouse is exercised
+ *   wclick X Y        the same with a left button press and release   wrclick X Y   right button
+ *   logstate          log windowed flag, SDL fullscreen flag, window size (points), drawable size (pixels),
+ *                     presentation rect (drawable pixels, top-left origin), GL viewport of the frame's last batch
+ *                     (bottom-left origin), mouse source rect (points), presentation scale, magnification filter,
+ *                     and the cubic budget state (last frame's cubic-qualified megapixels, budget, economy =
+ *                     sprites drawn bilinear because the budget was exceeded)
+ *   fps               log frames presented and the mean / max frame interval since the previous fps command
+ *                     (the first one only starts the measurement), the frames drawn in economy mode and the last
+ *                     frame's cubic-qualified megapixels
+ *   hitchlog MS       frame-hitch logger (PvzpHitch.h; also enabled at startup by the environment variable
+ *                     PVZP_HITCH_MS): log every presented frame whose interval exceeds MS milliseconds with its time
+ *                     split and what the main thread loaded in it ("PVZP_HITCH frame ..."); "hitchlog 0" turns it off
+ *   hitchstats        log the frames presented since the previous hitchstats (or hitchlog), the elapsed time, the
+ *                     number of frames longer than 25 / 33 / 50 / 100 ms, the worst frame and the GPU time per frame
+ *                     (mean, max, frames above 16.7 ms; macOS timer queries), then reset them
+ *   swapinterval N    SDL_GL_SetSwapInterval(N) on the current context (1 = vsync, -1 = adaptive, 0 = off)
+ *   stall N           block the main thread for N ms in this frame (to observe the main loop's catch-up)
+ *   preloadreanims    load every reanimation definition not loaded yet and log how long it took
+ *   quit              request shutdown
+ *
+ * SPDX-License-Identifier: LGPL-3.0-or-later
+ */
