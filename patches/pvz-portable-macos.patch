+
+static int LegacyByteWidth(Sexy::FontLayer* theLayer, char32_t theKey)
+{
+	auto anItr = theLayer->mCharDataMap.find(theKey);
+	return anItr != theLayer->mCharDataMap.end() ? anItr->second.mWidth : 0;
+}
+
+// 1051's CharWidthKern(0xFD, 0xFD): the translators' GBK half cell, in the layer's own units.
+static int LegacyHalfCell(Sexy::FontLayer* theLayer)
+{
+	int aWidth = LegacyByteWidth(theLayer, 0xFD) + theLayer->mSpacing;
+	auto anItr = theLayer->mCharDataMap.find(0xFD);
+	if (anItr != theLayer->mCharDataMap.end())
