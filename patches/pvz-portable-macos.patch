+// HD covers. The minigame, puzzle, survival and Limbo buttons show 80x65 cels of Challenge_Thumbnails.jpg and
+// Survival_Thumbnails.jpg, small JPEGs that look blurry once the scene is magnified (Retina drawables, large windows,
+// fullscreen). On such a presentation the cels come from images/{Challenge,Survival}_Thumbnails_{2,3,4}x.png instead:
+// AI-upscaled copies of the same sheets with the same cel layout at 2, 3 or 4 times the resolution (Mac port
+// provenance: analysis/tools/thumbs/README.md). The sheet drawn is the one whose scale is the smallest at or above
+// the presentation scale, into the same 80x65 logical rect: at an integer scale its texels map 1:1 to drawable
+// pixels, otherwise the GPU minifies it by less than 2x (where bilinear sampling stays close to an ideal resample)
+// or, beyond 4x, magnifies the 4x sheet. At a presentation scale of 1, and whenever a sheet is missing or does not
+// have the original layout at its scale, the original cel is drawn as before.
+static constexpr int HD_THUMBNAIL_MIN_SCALE = 2;
+static constexpr int HD_THUMBNAIL_MAX_SCALE = 4;
+static constexpr int NUM_HD_THUMBNAIL_SCALES = HD_THUMBNAIL_MAX_SCALE - HD_THUMBNAIL_MIN_SCALE + 1;
+
+// The HD sheets are shared by all challenge screens. The original sheets belong to DelayLoad_ChallengeScreen, which
+// stays loaded once a challenge screen has been shown (ResourceManager::ReleaseTrackedResources frees it only in
+// LOW_MEMORY builds), and the HD sheets live as long: decoding and uploading a 4x sheet again on every page open
+// would add tens of milliseconds to that page's first frame. When a screen closes, only the sheets for the current
+// presentation scale are kept (see ~ChallengeScreen), so a changed scale leaves no unused sheets behind. The cache is
+// heap-allocated and freed by ChallengeScreen::FreeHdThumbnails from ~LawnApp, while the GL interface still exists,
+// never by a static destructor.
+namespace
+{
+struct HdThumbnailCache
+{
+	// [0] challenge, [1] survival; per sheet the scales HD_THUMBNAIL_MIN_SCALE to HD_THUMBNAIL_MAX_SCALE.
+	std::array<std::array<std::unique_ptr<Image>, NUM_HD_THUMBNAIL_SCALES>, 2> mSheets;
+	std::array<std::array<bool, NUM_HD_THUMBNAIL_SCALES>, 2>                   mTried{};
+};
+HdThumbnailCache* gHdThumbnailCache = nullptr;
+}
+
+// The HD sheet scale for a presentation scale, or 0 for the original sheet.
+static int HdThumbnailScaleFor(float thePresentScale)
+{
+	// Scales within 2% count as that scale, as GLInterface treats magnifications up to 1.02 as unmagnified.
+	if (thePresentScale <= 1.02f)
+		return 0;
+	return std::clamp((int)std::ceil(thePresentScale - 0.02f), HD_THUMBNAIL_MIN_SCALE, HD_THUMBNAIL_MAX_SCALE);
+}
+
+// The HD sheet scale to draw with through g, or 0 for the original sheet.
+static int HdThumbnailScale(Graphics* g)
+{
+	// Graphics scaling changes the destination rect (see Graphics::DrawImage); the challenge screen never uses it.
+	if (g->mScaleX != 1.0f || g->mScaleY != 1.0f)
+		return 0;
+	GLImage* aDest = dynamic_cast<GLImage*>(g->mDestImage);
+	if (aDest == nullptr || aDest->mGLInterface == nullptr || aDest != aDest->mGLInterface->GetScreenImage())
+		return 0;
+	return HdThumbnailScaleFor(aDest->mGLInterface->mPresentationScale);
+}
+
+// The HD sheet at theScale, loaded on first use; nullptr when it is missing or its size is not the original's times
+// theScale. A failed load is not retried.
+static Image* GetHdThumbnails(LawnApp* theApp, bool theSurvival, int theScale)
+{
+	if (gHdThumbnailCache == nullptr)
+		gHdThumbnailCache = new HdThumbnailCache();
+	const int aSheet = theSurvival ? 1 : 0;
+	const int aSlot = theScale - HD_THUMBNAIL_MIN_SCALE;
+	std::unique_ptr<Image>& aSheetImage = gHdThumbnailCache->mSheets[aSheet][aSlot];
+	if (!gHdThumbnailCache->mTried[aSheet][aSlot])
+	{
+		gHdThumbnailCache->mTried[aSheet][aSlot] = true;
+		const Image* anOriginal = theSurvival ? Sexy::IMAGE_SURVIVAL_THUMBNAILS : Sexy::IMAGE_CHALLENGE_THUMBNAILS;
+		const std::string aPath = std::format("images/{}_Thumbnails_{}x.png", theSurvival ? "Survival" : "Challenge", theScale);
+		PerfTimer aTimer;
+		aTimer.Start();
+		std::unique_ptr<GLImage> anImage(theApp->GetImage(aPath));
+		if (anImage != nullptr && anOriginal != nullptr &&
+			anImage->mWidth == anOriginal->mWidth * theScale && anImage->mHeight == anOriginal->mHeight * theScale)
+		{
+			anImage->mRenderFlags |= RenderImageFlag_UseA8R8G8B8; // opaque images are uploaded as R5G6B5 by default
+			aSheetImage = std::move(anImage);
+			PvzpLogLn("HD covers: loaded '{}' (decode {} ms)", aPath, (int)aTimer.GetDuration());
+		}
+		else if (anImage != nullptr)
+		{
+			PvzpLogLn("HD covers: ignored '{}' ({}x{} is not {} times the original sheet)",
+				aPath, anImage->mWidth, anImage->mHeight, theScale);
+		}
+	}
+	return aSheetImage.get();
+}
+
+// Frees the cached HD sheets other than those for theKeepScale (0 frees all of them).
+static void TrimHdThumbnails(int theKeepScale)
+{
+	if (gHdThumbnailCache == nullptr)
+		return;
+	for (int aSheet = 0; aSheet < 2; aSheet++)
+	{
+		for (int aSlot = 0; aSlot < NUM_HD_THUMBNAIL_SCALES; aSlot++)
+		{
+			// Only loaded sheets are dropped (and may load again later); a failed load stays remembered.
+			if (aSlot + HD_THUMBNAIL_MIN_SCALE != theKeepScale && gHdThumbnailCache->mSheets[aSheet][aSlot] != nullptr)
+			{
+				gHdThumbnailCache->mSheets[aSheet][aSlot].reset();
+				gHdThumbnailCache->mTried[aSheet][aSlot] = false;
+			}
+		}
+	}
+}
+
+void ChallengeScreen::FreeHdThumbnails()
+{
+	delete gHdThumbnailCache;
+	gHdThumbnailCache = nullptr;
+}
+
+ChallengeScreen::~ChallengeScreen()
+{
+#ifdef LOW_MEMORY
+	// DelayLoad_ChallengeScreen is freed together with this screen in LOW_MEMORY builds; so are the HD covers.
+	FreeHdThumbnails();
+#else
+	// Keep the HD covers the next challenge screen will most likely draw with (see GetHdThumbnails).
+	if (gHdThumbnailCache != nullptr)
+		TrimHdThumbnails(mApp->mGLInterface != nullptr ? HdThumbnailScaleFor(mApp->mGLInterface->mPresentationScale) : 0);
+#endif
+}
+
+// Draws cel theCel of the survival or challenge thumbnail sheet at (theX, theY), at the original cel size.
+void ChallengeScreen::DrawThumbnail(Graphics* g, bool theSurvival, int theCel, int theX, int theY)
+{
+	Image* anOriginal = theSurvival ? Sexy::IMAGE_SURVIVAL_THUMBNAILS : Sexy::IMAGE_CHALLENGE_THUMBNAILS;
+	const int aScale = HdThumbnailScale(g);
+	Image* anHd = aScale > 0 ? GetHdThumbnails(mApp, theSurvival, aScale) : nullptr;
+	if (anHd == nullptr || anOriginal->mNumRows != 1 || theCel < 0 || theCel >= anOriginal->mNumCols)
+	{
+		g->DrawImageCel(anOriginal, theX, theY, theCel);
+		return;
+	}
+	const int aCelWidth = anOriginal->mWidth / anOriginal->mNumCols;
+	const int aCelHeight = anOriginal->mHeight;
+	g->DrawImage(anHd, Rect(theX, theY, aCelWidth, aCelHeight),
+		Rect(theCel * aCelWidth * aScale, 0, aCelWidth * aScale, aCelHeight * aScale));
+}
