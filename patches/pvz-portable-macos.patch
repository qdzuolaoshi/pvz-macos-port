+static int LegacyGbkLayerWidth(Sexy::FontLayer* theLayer, char32_t theChar, bool theHasPrev)
+{
+	std::string aBytes = LegacyGbkBytes(theChar);
+	if (aBytes.empty())
+		return 2 * LegacyByteWidth(theLayer, 0xFD) + theLayer->mSpacing + (theHasPrev ? theLayer->mSpacing : 0);
