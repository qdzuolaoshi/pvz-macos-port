+// macOS: a window that AppKit regards as zoomed ignores SDL_SetWindowSize; set its size as the game does
+// (MacWindowAspectSetContentSize). False: use SDL_SetWindowSize.
+static bool PvzpTestSetContentSize(int theWidth, int theHeight)
+{
+#if defined(__APPLE__) && !defined(__IPHONEOS__)
+	return MacWindowAspectSetContentSize(theWidth, theHeight);
+#else
+	(void)theWidth;
+	(void)theHeight;
+	return false;
+#endif
+}
+
+// theLogical: box-filter the presentation rect down to the app's logical size (800x600). theFull: the whole drawable
+// (the presentation rect and the letterbox bars around it) instead of the presentation rect.
+static void PvzpTestWriteShot(SexyAppBase* theApp, const std::string& theName, bool theLogical = false, bool theFull = false)
+{
+	const char* aDir = std::getenv("PVZP_TEST_SHOTDIR");
+	std::string aPath = std::string(aDir ? aDir : ".") + "/" + theName + ".png";
+
+	int aDrawW = 0, aDrawH = 0;
+	SDL_GL_GetDrawableSize((SDL_Window*)theApp->mWindow, &aDrawW, &aDrawH);
+	const Rect r = theFull ? Rect(0, 0, aDrawW, aDrawH) : theApp->mGLInterface->mPresentationRect;
+	int w = r.mWidth, h = r.mHeight;
+	if (w <= 0 || h <= 0)
+		return;
+
+	std::vector<uint8_t> aPixels((size_t)w * h * 4);
+	glPixelStorei(GL_PACK_ALIGNMENT, 1);
+	// GL origin is bottom-left; mPresentationRect is in drawable pixels with a top-left origin.
+	glReadPixels(r.mX, aDrawH - r.mY - h, w, h, GL_RGBA, GL_UNSIGNED_BYTE, aPixels.data());
+
+	int anOutW = w, anOutH = h;
+	if (theLogical && (w != theApp->mWidth || h != theApp->mHeight))
+	{
+		// Separable box filter in float, per channel: rows first (w -> outW), then columns (h -> outH).
+		anOutW = theApp->mWidth;
+		anOutH = theApp->mHeight;
+		std::vector<float> aSrc((size_t)w * h), aRows((size_t)anOutW * h), aOut((size_t)anOutW * anOutH);
+		std::vector<uint8_t> aResult((size_t)anOutW * anOutH * 4);
+		for (int c = 0; c < 3; c++)
+		{
+			for (size_t i = 0; i < aSrc.size(); i++)
+				aSrc[i] = aPixels[i * 4 + c];
+			for (int y = 0; y < h; y++)
+				PvzpTestBoxResample(&aSrc[(size_t)y * w], w, 1, &aRows[(size_t)y * anOutW], anOutW, 1);
+			for (int x = 0; x < anOutW; x++)
+				PvzpTestBoxResample(&aRows[x], h, anOutW, &aOut[x], anOutH, anOutW);
+			for (size_t i = 0; i < aOut.size(); i++)
+				aResult[i * 4 + c] = (uint8_t)std::clamp((int)std::lround(aOut[i]), 0, 255);
+		}
+		aPixels.swap(aResult);
+	}
+
+	ImageLib::Image anImage;
+	anImage.mWidth = anOutW;
+	anImage.mHeight = anOutH;
+	anImage.mBits = std::make_unique<uint32_t[]>((size_t)anOutW * anOutH);
+	uint32_t* aBits = anImage.mBits.get();
+	for (int y = 0; y < anOutH; y++)
+	{
+		const uint8_t* aRow = aPixels.data() + (size_t)(anOutH - 1 - y) * anOutW * 4;
+		for (int x = 0; x < anOutW; x++)
+		{
+			const uint8_t* p = aRow + x * 4;
+			aBits[y * anOutW + x] = 0xFF000000u | ((uint32_t)p[0] << 16) | ((uint32_t)p[1] << 8) | p[2];
+		}
+	}
+	ImageLib::WritePNGImage(aPath, &anImage);
+	SDL_Log("PVZP_TEST shot %s (%dx%d)", aPath.c_str(), anOutW, anOutH);
+}
+
+// Pushes a real SDL mouse event at the window point under logical position (theX, theY): the inverse of
+// WidgetManager::RemapMouse through the window-space presentation rect.
+static void PvzpTestPushMouse(SexyAppBase* theApp, Uint32 theType, int theX, int theY, Uint8 theButton)
+{
+	if (theApp->mWindow == nullptr || theApp->mWidgetManager == nullptr)
+		return;
+	const Rect& aSrc = theApp->mWidgetManager->mMouseSourceRect;
+	const Rect& aDst = theApp->mWidgetManager->mMouseDestRect;
+	if (aDst.mWidth <= 0 || aDst.mHeight <= 0)
+		return;
+	// Smallest window point that RemapMouse maps to theX (exact whenever the rect is at least as large as the scene).
+	int aPointX = aSrc.mX + ((theX - aDst.mX) * aSrc.mWidth + aDst.mWidth - 1) / aDst.mWidth;
+	int aPointY = aSrc.mY + ((theY - aDst.mY) * aSrc.mHeight + aDst.mHeight - 1) / aDst.mHeight;
+
+	SDL_Event anEvent;
+	SDL_zero(anEvent);
+	anEvent.type = theType;
+	const Uint32 aWindowID = SDL_GetWindowID((SDL_Window*)theApp->mWindow);
+	if (theType == SDL_MOUSEMOTION)
+	{
+		anEvent.motion.windowID = aWindowID;
+		anEvent.motion.x = aPointX;
+		anEvent.motion.y = aPointY;
+	}
+	else
+	{
+		anEvent.button.windowID = aWindowID;
+		anEvent.button.button = theButton;
+		anEvent.button.state = theType == SDL_MOUSEBUTTONDOWN ? SDL_PRESSED : SDL_RELEASED;
+		anEvent.button.clicks = 1;
+		anEvent.button.x = aPointX;
+		anEvent.button.y = aPointY;
+	}
+	SDL_PushEvent(&anEvent);
+}
+
+namespace
+{
+
+enum class HookInputKind { MOVE, DOWN, UP, CHAR, KEY_DOWN, KEY_UP };
+
+struct HookInput
+{
+	HookInputKind	mKind;
+	int				mX = 0;
+	int				mY = 0;
+	int				mValue = 0; // mouse button, character or key code
+};
+
+// Input queued by the script and delivered from ProcessDeferredMessages, i.e. in the MESSAGES phase of
+// UpdateAppStep like real SDL input. Injecting it from Flush (the draw phase of Process) would let a dialog
+// deleted by ProcessSafeDeleteList at the end of that Process be used by Dialog::WaitForResult afterwards.
+std::deque<HookInput> gPendingInput;
+
+}
+
+bool PvzpTestHookPumpInput(SexyAppBase* theApp)
+{
+	if (gPendingInput.empty() || theApp->mWidgetManager == nullptr)
+		return false;
+
+	// Pop first: delivering the input can open a nested modal loop that pumps the following entries.
+	HookInput anInput = gPendingInput.front();
+	gPendingInput.pop_front();
+
+	WidgetManager* wm = theApp->mWidgetManager.get();
+	theApp->mLastUserInputTick = theApp->mLastTimerTime;
+	switch (anInput.mKind)
+	{
+	case HookInputKind::MOVE:
+		wm->MouseMove(anInput.mX, anInput.mY);
+		break;
+	case HookInputKind::DOWN:
+		wm->MouseMove(anInput.mX, anInput.mY);
+		wm->MouseDown(anInput.mX, anInput.mY, anInput.mValue);
+		break;
+	case HookInputKind::UP:
+		wm->MouseMove(anInput.mX, anInput.mY);
+		wm->MouseUp(anInput.mX, anInput.mY, anInput.mValue);
+		break;
+	case HookInputKind::CHAR:
+		wm->KeyChar((char)anInput.mValue);
+		break;
+	case HookInputKind::KEY_DOWN:
+		wm->KeyDown((KeyCode)anInput.mValue);
+		break;
+	case HookInputKind::KEY_UP:
+		wm->KeyUp((KeyCode)anInput.mValue);
+		break;
+	}
+	return true;
+}
+
+// Sound starts (SDLSoundManager::GetSoundInstance), for "waitsound" and, with PVZP_TEST_SOUNDLOG=1, the log.
+static std::string gPvzpTestWaitSound;	// "waitsound" in progress: the name fragment it waits for
+static bool gPvzpTestWaitSoundSeen = false;
+
+void PvzpTestNoteSound(const std::string& theName)
+{
+	static const bool sScript = std::getenv("PVZP_TEST_SCRIPT") != nullptr;
+	static const bool sLog = sScript && std::getenv("PVZP_TEST_SOUNDLOG") != nullptr;
+	if (!sScript)
+		return;
+	if (sLog)
+		SDL_Log("PVZP_TEST sound %s", theName.c_str());
+	if (!gPvzpTestWaitSound.empty() && theName.find(gPvzpTestWaitSound) != std::string::npos)
+		gPvzpTestWaitSoundSeen = true;
+}
+
+void PvzpTestHookFrame(SexyAppBase* theApp)
+{
+	// Called from GLInterface::Flush between the GPU submit and the swap.
+	if (gPvzpHitchOn && HitchOnMainThread())
+	{
+		gHitchFrame.mPresentId = HitchGpuTimerFrame();
+		gHitchFrame.mFlushDoneTicks = PvzpHitchTicks();
+	}
+
+	static const char* sScriptPath = std::getenv("PVZP_TEST_SCRIPT");
+	if (sScriptPath == nullptr || theApp->mWidgetManager == nullptr)
+		return;
+
+	// Frame statistics for "fps", counted for every presented frame, nested ones included.
+	static Uint64 sLastFrameCounter = 0;
+	static Uint64 sFpsStartCounter = 0;
+	static int sFpsFrames = 0;
+	static double sFpsMaxMs = 0;
+	static long sFpsEconomyFrames = 0;	// GLInterface economy frame count at the previous fps command
+	{
+		const Uint64 aNow = SDL_GetPerformanceCounter();
+		if (sLastFrameCounter != 0)
+		{
+			const double aMs = (double)(aNow - sLastFrameCounter) * 1000.0 / (double)SDL_GetPerformanceFrequency();
+			sFpsFrames++;
+			sFpsMaxMs = std::max(sFpsMaxMs, aMs);
+		}
+		sLastFrameCounter = aNow;
+	}
+
+	// Never run the script from a nested frame of a command that is still executing.
+	static bool sActive = false;
+	if (sActive)
+		return;
+	struct ActiveGuard
+	{
+		ActiveGuard() { sActive = true; }
+		~ActiveGuard() { sActive = false; }
+	} anActiveGuard;
+
+	static std::vector<std::string> sLines;
+	static bool sLoaded = false;
+	static size_t sIndex = 0;
+	static int sWait = 0;
+	static Uint32 sWaitUntil = 0;
+	if (!sLoaded)
+	{
+		sLoaded = true;
+		std::ifstream aFile(sScriptPath);
+		std::string aLine;
+		while (std::getline(aFile, aLine))
+			if (!aLine.empty() && aLine[0] != '#')
+				sLines.push_back(aLine);
+	}
+
+	// Queued input has not been delivered yet: the next command (often "ms N") starts after it ran.
+	if (!gPendingInput.empty())
+		return;
+
+	while (sIndex < sLines.size())
+	{
+		if (sWait > 0)
+		{
+			sWait--;
+			return;
+		}
+		if (!gPvzpTestWaitSound.empty())
+		{
+			static Uint32 sWaitSoundDeadline = 0;
+			if (sWaitUntil != 0) // set by the waitsound command below: becomes its deadline
+			{
+				sWaitSoundDeadline = sWaitUntil;
+				sWaitUntil = 0;
+			}
+			const bool aTimedOut = SDL_GetTicks() >= sWaitSoundDeadline;
+			if (!gPvzpTestWaitSoundSeen && !aTimedOut)
+				return;
+			SDL_Log("PVZP_TEST waitsound %s %s", gPvzpTestWaitSound.c_str(), gPvzpTestWaitSoundSeen ? "started" : "TIMEOUT");
+			gPvzpTestWaitSound.clear();
+		}
+		if (sWaitUntil != 0)
+		{
+			if (SDL_GetTicks() < sWaitUntil)
+				return;
+			sWaitUntil = 0;
+		}
+
+		std::istringstream aStream(sLines[sIndex++]);
+		std::string aCmd;
+		aStream >> aCmd;
+		if (aCmd == "wait")
+		{
+			aStream >> sWait;
+			return;
+		}
+		else if (aCmd == "ms")
+		{
+			Uint32 aMs = 0;
+			aStream >> aMs;
+			sWaitUntil = SDL_GetTicks() + std::max<Uint32>(aMs, 1);
+			return;
+		}
+		else if (aCmd == "waitsound")
+		{
+			std::string aName;
+			Uint32 aMaxMs = 60000;
+			aStream >> aName >> aMaxMs;
+			if (!aName.empty())
+			{
+				gPvzpTestWaitSound = aName;
+				gPvzpTestWaitSoundSeen = false;
+				sWaitUntil = SDL_GetTicks() + std::max<Uint32>(aMaxMs, 1); // taken over as the deadline above
+			}
+			return;
+		}
+		else if (aCmd == "move" || aCmd == "click" || aCmd == "rclick")
+		{
+			int x = 0, y = 0;
+			aStream >> x >> y;
+			if (aCmd == "move")
+				gPendingInput.push_back({ HookInputKind::MOVE, x, y, 0 });
+			else
+			{
+				int aBtn = aCmd == "click" ? 1 : -1;
+				gPendingInput.push_back({ HookInputKind::DOWN, x, y, aBtn });
+				gPendingInput.push_back({ HookInputKind::UP, x, y, aBtn });
+			}
+			return;
+		}
+		else if (aCmd == "char")
+		{
+			std::string c;
+			aStream >> c;
+			if (!c.empty())
+			{
+				gPendingInput.push_back({ HookInputKind::CHAR, 0, 0, (int)(unsigned char)c[0] });
+				return;
+			}
+		}
+		else if (aCmd == "type")
+		{
+			std::string aText;
+			std::getline(aStream, aText);
+			if (!aText.empty() && aText[0] == ' ')
+				aText.erase(0, 1);
+			for (char c : aText)
+				gPendingInput.push_back({ HookInputKind::CHAR, 0, 0, (int)(unsigned char)c });
+			if (!gPendingInput.empty())
+				return;
+		}
+		else if (aCmd == "keydown")
+		{
+			int aCode = 0;
+			aStream >> aCode;
+			gPendingInput.push_back({ HookInputKind::KEY_DOWN, 0, 0, aCode });
+			gPendingInput.push_back({ HookInputKind::KEY_UP, 0, 0, aCode });
+			return;
+		}
+		else if (aCmd == "shot" || aCmd == "shotlogical" || aCmd == "shotfull")
+		{
+			std::string aName;
+			aStream >> aName;
+			PvzpTestWriteShot(theApp, aName, aCmd == "shotlogical", aCmd == "shotfull");
+		}
+		else if (aCmd == "winsize")
+		{
+			int aW = 0, aH = 0;
+			aStream >> aW >> aH;
+			SDL_Window* aWindow = (SDL_Window*)theApp->mWindow;
+			if (aWindow != nullptr && aW > 0 && aH > 0)
+			{
+				const int aDisplay = std::max(0, SDL_GetWindowDisplayIndex(aWindow));
+				if (!PvzpTestSetContentSize(aW, aH))
+					SDL_SetWindowSize(aWindow, aW, aH);
+				SDL_SetWindowPosition(aWindow, SDL_WINDOWPOS_CENTERED_DISPLAY(aDisplay), SDL_WINDOWPOS_CENTERED_DISPLAY(aDisplay));
+			}
+			return;
+		}
+		else if (aCmd == "winzoom")
+		{
+			// Maximize / restore the window (on macOS AppKit's zoom, as a title-bar double-click does).
+			int anOn = 0;
+			aStream >> anOn;
+			SDL_Window* aWindow = (SDL_Window*)theApp->mWindow;
+			if (aWindow != nullptr)
+			{
+				if (anOn)
+					SDL_MaximizeWindow(aWindow);
+				else
+					SDL_RestoreWindow(aWindow);
+			}
+			return;
+		}
+		else if (aCmd == "winframe")
+		{
+			// Place the window's outer frame (title bar included) at X Y with size W x H, in SDL global points, e.g.
+			// flush with the display's usable bounds to imitate tiling; the usable bounds are logged. When SDL reports
+			// no border sizes (all 0, as sdl2-compat over SDL3 does on macOS here), X Y W H is the content rect.
+			int aX = 0, aY = 0, aW = 0, aH = 0;
+			aStream >> aX >> aY >> aW >> aH;
+			SDL_Window* aWindow = (SDL_Window*)theApp->mWindow;
+			if (aWindow != nullptr && aW > 0 && aH > 0)
+			{
+				int aTop = 0, aLeft = 0, aBottom = 0, aRight = 0;
+				const int aBordersResult = SDL_GetWindowBordersSize(aWindow, &aTop, &aLeft, &aBottom, &aRight);
+				SDL_Rect aUsable = { 0, 0, 0, 0 };
+				SDL_GetDisplayUsableBounds(std::max(0, SDL_GetWindowDisplayIndex(aWindow)), &aUsable);
+				SDL_Log("PVZP_TEST winframe %d,%d %dx%d borders=%d,%d,%d,%d (rc %d) usable=%d,%d,%dx%d", aX, aY, aW, aH,
+					aTop, aLeft, aBottom, aRight, aBordersResult, aUsable.x, aUsable.y, aUsable.w, aUsable.h);
+				if (!PvzpTestSetContentSize(std::max(1, aW - aLeft - aRight), std::max(1, aH - aTop - aBottom)))
+					SDL_SetWindowSize(aWindow, std::max(1, aW - aLeft - aRight), std::max(1, aH - aTop - aBottom));
+				SDL_SetWindowPosition(aWindow, aX + aLeft, aY + aTop);
+			}
+			return;
+		}
+		else if (aCmd == "wmove" || aCmd == "wclick" || aCmd == "wrclick")
+		{
+			int x = 0, y = 0;
+			aStream >> x >> y;
+			PvzpTestPushMouse(theApp, SDL_MOUSEMOTION, x, y, 0);
+			if (aCmd != "wmove")
+			{
+				const Uint8 aButton = aCmd == "wclick" ? SDL_BUTTON_LEFT : SDL_BUTTON_RIGHT;
+				PvzpTestPushMouse(theApp, SDL_MOUSEBUTTONDOWN, x, y, aButton);
+				PvzpTestPushMouse(theApp, SDL_MOUSEBUTTONUP, x, y, aButton);
+			}
+			return;
+		}
+		else if (aCmd == "fps")
+		{
+			const Uint64 aNow = SDL_GetPerformanceCounter();
+			if (sFpsStartCounter != 0 && sFpsFrames > 0)
+			{
+				const double anElapsedMs = (double)(aNow - sFpsStartCounter) * 1000.0 / (double)SDL_GetPerformanceFrequency();
+				float anArea = 0, aBudget = 0;
+				bool anEconomy = false;
+				long anEconomyFrames = 0;
+				GLInterface::GetCubicBudgetState(anArea, aBudget, anEconomy, anEconomyFrames);
+				SDL_Log("PVZP_TEST fps frames=%d elapsed=%.0fms fps=%.1f meanInterval=%.2fms maxInterval=%.2fms "
+					"economyFrames=%ld cubicMpx=%.2f", sFpsFrames, anElapsedMs, sFpsFrames * 1000.0 / anElapsedMs,
+					anElapsedMs / sFpsFrames, sFpsMaxMs, anEconomyFrames - sFpsEconomyFrames, anArea / 1.0e6f);
+				sFpsEconomyFrames = anEconomyFrames;
+			}
+			else
+			{
+				float anArea = 0, aBudget = 0;
+				bool anEconomy = false;
+				GLInterface::GetCubicBudgetState(anArea, aBudget, anEconomy, sFpsEconomyFrames);
+				SDL_Log("PVZP_TEST fps measurement started");
+			}
+			sFpsStartCounter = aNow;
+			sLastFrameCounter = aNow; // the time spent on earlier commands of this frame (shots) is not counted
+			sFpsFrames = 0;
+			sFpsMaxMs = 0;
+		}
+		else if (aCmd == "hitchlog")
+		{
+			double aMs = 0;
+			aStream >> aMs;
+			HitchFlushPendingLines(true);
+			HitchGpuTimerStop();
+			gPvzpHitchThresholdMs = std::max(0.0, aMs);
+			gPvzpHitchOn = gPvzpHitchThresholdMs > 0.0;
+			gHitchFrame = HitchFrame();
+			gHitchLastFrameEnd = 0;	// the next presented frame starts the measurement
+			gHitchTexScanValid = false;
+			gHitchStats = HitchStats();
+			SDL_Log("PVZP_TEST hitchlog %s threshold=%.1fms", gPvzpHitchOn ? "on" : "off", gPvzpHitchThresholdMs);
+		}
+		else if (aCmd == "hitchstats")
+		{
+			PvzpHitchLogStats();
+		}
+		else if (aCmd == "preloadreanims")
+		{
+			const Uint64 aStart = SDL_GetPerformanceCounter();
+			const int aCount = ReanimatorPreloadAllDefinitions();
+			SDL_Log("PVZP_TEST preloadreanims loaded=%d in %.1fms", aCount,
+				(double)(SDL_GetPerformanceCounter() - aStart) * 1000.0 / (double)SDL_GetPerformanceFrequency());
+		}
+		else if (aCmd == "stall")
+		{
+			// Block the main thread for N ms inside this frame (a stand-in for a load or a system stall), to observe
+			// how the main loop catches up afterwards (logic steps per frame in the hitch log).
+			int aMs = 0;
+			aStream >> aMs;
+			SDL_Log("PVZP_TEST stall %d ms", aMs);
+			SDL_Delay((Uint32)std::max(0, aMs));
+		}
+		else if (aCmd == "swapinterval")
+		{
+			int anInterval = 1;
+			aStream >> anInterval;
+			const int aResult = SDL_GL_SetSwapInterval(anInterval);
+			SDL_Log("PVZP_TEST swapinterval %d -> %d (now %d)", anInterval, aResult, SDL_GL_GetSwapInterval());
+		}
+		else if (aCmd == "log")
+		{
+			std::string aText;
+			std::getline(aStream, aText);
+			SDL_Log("PVZP_TEST %s", aText.c_str());
+		}
+		else if (aCmd == "osfullscreen")
+		{
+			// Change the screen mode the way the green window button / Ctrl+Cmd+F does: directly on the
+			// SDL window, bypassing SwitchScreenMode.
+			int anOn = 0;
+			aStream >> anOn;
+			if (theApp->mWindow != nullptr)
+				SDL_SetWindowFullscreen((SDL_Window*)theApp->mWindow, anOn ? SDL_WINDOW_FULLSCREEN_DESKTOP : 0);
+			return;
+		}
+		else if (aCmd == "sdlkey")
+		{
+			// Push a real SDL key press (keydown + keyup) through the SDL event queue, e.g. "sdlkey 13 256"
+			// for Option+Return (SDLK_RETURN, KMOD_LALT).
+			int aSym = 0, aMod = 0;
+			aStream >> aSym >> aMod;
+			SDL_Event anEvent;
+			SDL_zero(anEvent);
+			anEvent.type = SDL_KEYDOWN;
+			anEvent.key.state = SDL_PRESSED;
+			anEvent.key.keysym.sym = (SDL_Keycode)aSym;
+			anEvent.key.keysym.scancode = SDL_GetScancodeFromKey((SDL_Keycode)aSym);
+			anEvent.key.keysym.mod = (Uint16)aMod;
+			if (theApp->mWindow != nullptr)
+				anEvent.key.windowID = SDL_GetWindowID((SDL_Window*)theApp->mWindow);
