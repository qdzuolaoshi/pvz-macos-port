+// The CP936 (GBK) bytes of theChar, or an empty string when it has no GBK encoding.
+static std::string LegacyGbkBytes(char32_t theChar)
+{
+	static std::mutex sMutex;
+	static std::unordered_map<char32_t, std::string> sCache;
+	std::scoped_lock aLock(sMutex);
+	auto anItr = sCache.find(theChar);
+	if (anItr != sCache.end())
+		return anItr->second;
+
+	std::string aBytes;
+#ifdef PVZP_LEGACY_HAVE_ICONV
+	static iconv_t sConv = iconv_open("CP936", "UTF-32LE");
+	if (sConv != (iconv_t)-1)
+	{
+		char anIn[4] = { (char)(theChar & 0xFF), (char)((theChar >> 8) & 0xFF), (char)((theChar >> 16) & 0xFF), (char)((theChar >> 24) & 0xFF) };
+		char anOut[8];
+		char* anInPtr = anIn;
+		char* anOutPtr = anOut;
+		size_t anInLeft = sizeof(anIn), anOutLeft = sizeof(anOut);
+		iconv(sConv, nullptr, nullptr, nullptr, nullptr);
+		if (iconv(sConv, &anInPtr, &anInLeft, &anOutPtr, &anOutLeft) != (size_t)-1 && anInLeft == 0)
+			aBytes.assign(anOut, anOutPtr - anOut);
+	}
+#endif
+	sCache.emplace(theChar, aBytes);
+	return aBytes;
+}
+
+int Sexy::LegacyGbkByteCount(char32_t theChar)
+{
+	if (theChar < 0x80)
+		return 1;
+	size_t aLen = LegacyGbkBytes(theChar).size();
+	return aLen > 0 ? (int)aLen : 2;
