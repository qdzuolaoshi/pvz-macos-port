+// Smoothness (macOS port): a resumed level skips the level intro, so CutScene::PreloadResources never runs for it and
+// the definitions of the zombies still to come, of the player's plants and of the stage's effects were loaded (and
+// their images decoded) on first use in the middle of play. Load the same set while the saved level is being opened.
+// Definitions only: nothing in the game state changes.
+static void LawnPreloadResumedLevelResources(Board* theBoard)
+{
+	LawnApp* anApp = theBoard->mApp;
+	for (int aWave = 0; aWave < theBoard->mNumWaves && aWave < MAX_ZOMBIE_WAVES; aWave++)
+	{
+		for (int aZombieIndex = 0; aZombieIndex < MAX_ZOMBIES_IN_WAVE; aZombieIndex++)
+		{
+			ZombieType aZombieType = theBoard->mZombiesInWave[aWave][aZombieIndex];
+			if (aZombieType == ZombieType::ZOMBIE_INVALID)
+				break;
+			if (aZombieType >= 0 && aZombieType < ZombieType::NUM_ZOMBIE_TYPES)
+				Zombie::PreloadZombieResources(aZombieType);
+		}
+	}
+
+	for (int aSeed = SeedType::SEED_PEASHOOTER; aSeed < SeedType::NUM_SEED_TYPES; aSeed++)
+	{
+		if (anApp->HasSeedType(static_cast<SeedType>(aSeed)))
+			Plant::PreloadPlantResources(static_cast<SeedType>(aSeed));
+	}
+	if (anApp->IsFirstTimeAdventureMode() && theBoard->mLevel <= 50)
+		Plant::PreloadPlantResources(anApp->GetAwardSeedForLevel(theBoard->mLevel));
+	if (anApp->IsFinalBossLevel())
+		Zombie::PreloadZombieResources(ZombieType::ZOMBIE_BOSS);
+
+	if (theBoard->StageHasRoof())
+		ReanimatorEnsureDefinitionLoaded(ReanimationType::REANIM_ROOF_CLEANER, true);
+	else
+		ReanimatorEnsureDefinitionLoaded(ReanimationType::REANIM_LAWNMOWER, true);
+	if (theBoard->StageHasPool())
+	{
+		ReanimatorEnsureDefinitionLoaded(ReanimationType::REANIM_SPLASH, true);
+		ReanimatorEnsureDefinitionLoaded(ReanimationType::REANIM_POOL_CLEANER, true);
+	}
+	if (theBoard->CanDropLoot())
+	{
+		ReanimatorEnsureDefinitionLoaded(ReanimationType::REANIM_COIN_SILVER, true);
+		ReanimatorEnsureDefinitionLoaded(ReanimationType::REANIM_COIN_GOLD, true);
+		ReanimatorEnsureDefinitionLoaded(ReanimationType::REANIM_DIAMOND, true);
+	}
+	if (anApp->mGameMode == GameMode::GAMEMODE_CHALLENGE_PORTAL_COMBAT)
+	{
+		ReanimatorEnsureDefinitionLoaded(ReanimationType::REANIM_PORTAL_CIRCLE, true);
+		ReanimatorEnsureDefinitionLoaded(ReanimationType::REANIM_PORTAL_SQUARE, true);
+	}
+	if (anApp->IsWhackAZombieLevel() || anApp->IsScaryPotterLevel())
+		ReanimatorEnsureDefinitionLoaded(ReanimationType::REANIM_HAMMER, true);
+	if (anApp->IsStormyNightLevel() || anApp->mGameMode == GameMode::GAMEMODE_CHALLENGE_RAINING_SEEDS)
+	{
+		ReanimatorEnsureDefinitionLoaded(ReanimationType::REANIM_RAIN_CIRCLE, true);
+		ReanimatorEnsureDefinitionLoaded(ReanimationType::REANIM_RAIN_SPLASH, true);
+	}
+}
