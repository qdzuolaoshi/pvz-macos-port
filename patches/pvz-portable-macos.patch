+static void LegacyDrawHdGlyph(Sexy::Graphics* g, const Sexy::RenderCommand* theCommand)
+{
+	Sexy::GLImage* aDest = dynamic_cast<Sexy::GLImage*>(g->mDestImage);
+	if (aDest == nullptr || aDest->mGLInterface == nullptr)
