+static double PvzpHitchThresholdFromEnv()
+{
+	const char* aValue = std::getenv("PVZP_HITCH_MS");
+	return aValue != nullptr ? std::max(0.0, std::atof(aValue)) : 0.0;
+}
+
+static double gPvzpHitchThresholdMs = PvzpHitchThresholdFromEnv();
+bool gPvzpHitchOn = gPvzpHitchThresholdMs > 0.0;
+// Enabled from the environment without a test script (manual play): log the statistics once a minute.
+static const bool gPvzpHitchAutoStats = gPvzpHitchOn && std::getenv("PVZP_TEST_SCRIPT") == nullptr;
+static const std::thread::id gPvzpHitchMainThread = std::this_thread::get_id(); // static initialisation runs on main
+
+namespace
+{
+
+struct HitchFrame
+{
+	uint64_t	mPhaseTicks[NUM_HITCH_PHASES] = {};
+	uint64_t	mPhaseMaxTicks[NUM_HITCH_PHASES] = {};	// longest single scope of the phase (e.g. one logic step)
+	int64_t		mCounters[NUM_HITCH_COUNTERS] = {};
+	uint64_t	mFlushDoneTicks = 0;					// GfxFlush finished, SDL_GL_SwapWindow follows
+	long		mPresentId = 0;						// GPU timer id of the frame (see HitchGpuTimerFrame)
+	std::string	mNotes;
+	int			mNoteCount = 0;
+};
+
+struct HitchStats
+{
+	uint64_t	mStartTicks = 0;
+	long		mFrames = 0;
+	long		mOver[4] = {};		// > 25, 33, 50, 100 ms
+	double		mWorstMs = 0;
+	long		mGpuFrames = 0;		// frames with a GPU time (timer query results that arrived in the window)
+	double		mGpuSumMs = 0;
+	double		mGpuMaxMs = 0;
+	long		mGpuOver16 = 0;		// GPU time above 16.7 ms
+	double		mPhaseSumMs[NUM_HITCH_PHASES] = {};	// per-frame phase totals: sum and maximum over the window
+	double		mPhaseMaxMs[NUM_HITCH_PHASES] = {};
+	double		mStepMaxMs = 0;		// longest single logic step
+	long		mHist[7] = {};		// frame intervals: <=17.5, <=20, <=25, <=33.4, <=50, <=100, >100 ms
+};
+
+// A hitch line waits for its frame's GPU time (timer query results arrive a few frames later).
+struct HitchPendingLine
+{
+	long		mPresentId;
+	std::string	mHead;	// up to the interval
+	std::string	mTail;
+};
+
+HitchFrame	gHitchFrame;
+HitchStats	gHitchStats;
+uint64_t	gHitchLastFrameEnd = 0;
+unsigned	gHitchLastUpdateCount = 0;
+long		gHitchFrameNumber = 0;
+bool		gHitchTexScanValid = false;
+long		gHitchTexImages = 0;
+int64_t		gHitchTexBytes = 0;
+int64_t		gHitchTexBitsChanged = 0;
+
+constexpr double HITCH_STAT_LIMITS[4] = { 25.0, 33.0, 50.0, 100.0 };
+
+std::deque<HitchPendingLine> gHitchPendingLines;
+long	gHitchPresentCount = 0;
+constexpr int HITCH_GPU_HISTORY = 64;
+double	gHitchGpuMs[HITCH_GPU_HISTORY];
+long	gHitchGpuId[HITCH_GPU_HISTORY] = {};
+
+// GPU time per presented frame from GL_TIME_ELAPSED timer queries (EXT_timer_query, available on macOS OpenGL),
+// bracketing the commands between two consecutive GfxFlush/swap points. macOS only: glad (GLES2) does not load the
+// query entry points, so they are fetched with SDL_GL_GetProcAddress.
+#if defined(__APPLE__) && !defined(__IPHONEOS__)
+#define PVZP_HITCH_GPU_TIMER 1
+typedef void (*HitchPfnGenQueries)(GLsizei, GLuint*);
+typedef void (*HitchPfnDeleteQueries)(GLsizei, const GLuint*);
+typedef void (*HitchPfnBeginQuery)(GLenum, GLuint);
+typedef void (*HitchPfnEndQuery)(GLenum);
+typedef void (*HitchPfnGetQueryObjectiv)(GLuint, GLenum, GLint*);
+typedef void (*HitchPfnGetQueryObjectui64v)(GLuint, GLenum, uint64_t*);
+constexpr GLenum HITCH_GL_TIME_ELAPSED = 0x88BF;
+constexpr GLenum HITCH_GL_QUERY_RESULT = 0x8866;
+constexpr GLenum HITCH_GL_QUERY_RESULT_AVAILABLE = 0x8867;
+constexpr int HITCH_GPU_RING = 8;
+
+struct HitchGpuTimer
+{
+	bool						mInited = false;
+	bool						mAvailable = false;
+	bool						mRunning = false;
+	int							mRunningSlot = 0;
+	GLuint						mQueries[HITCH_GPU_RING] = {};
+	long						mIdOf[HITCH_GPU_RING] = {};
+	bool						mPending[HITCH_GPU_RING] = {};
+	HitchPfnGenQueries			mGenQueries = nullptr;
+	HitchPfnBeginQuery			mBeginQuery = nullptr;
+	HitchPfnEndQuery			mEndQuery = nullptr;
+	HitchPfnGetQueryObjectiv	mGetQueryObjectiv = nullptr;
+	HitchPfnGetQueryObjectui64v	mGetQueryObjectui64v = nullptr;
+};
+HitchGpuTimer gHitchGpu;
+#endif
+
+void HitchStoreGpuMs(long theId, double theMs)
+{
+	gHitchGpuMs[theId % HITCH_GPU_HISTORY] = theMs;
+	gHitchGpuId[theId % HITCH_GPU_HISTORY] = theId;
+	gHitchStats.mGpuFrames++;
+	gHitchStats.mGpuSumMs += theMs;
+	gHitchStats.mGpuMaxMs = std::max(gHitchStats.mGpuMaxMs, theMs);
+	if (theMs > 16.7)
+		gHitchStats.mGpuOver16++;
+}
+
+// Called at the swap point of every presented frame while the logger is on: closes the query of this frame's
+// commands, opens the next one and collects finished results. Returns this frame's id.
+long HitchGpuTimerFrame()
+{
+	const long anId = ++gHitchPresentCount;
+#ifdef PVZP_HITCH_GPU_TIMER
+	HitchGpuTimer& g = gHitchGpu;
+	if (!g.mInited)
+	{
+		g.mInited = true;
+		g.mGenQueries = (HitchPfnGenQueries)SDL_GL_GetProcAddress("glGenQueries");
+		g.mBeginQuery = (HitchPfnBeginQuery)SDL_GL_GetProcAddress("glBeginQuery");
+		g.mEndQuery = (HitchPfnEndQuery)SDL_GL_GetProcAddress("glEndQuery");
+		g.mGetQueryObjectiv = (HitchPfnGetQueryObjectiv)SDL_GL_GetProcAddress("glGetQueryObjectiv");
+		g.mGetQueryObjectui64v = (HitchPfnGetQueryObjectui64v)SDL_GL_GetProcAddress("glGetQueryObjectui64vEXT");
+		g.mAvailable = SDL_GL_ExtensionSupported("GL_EXT_timer_query") && g.mGenQueries && g.mBeginQuery &&
+			g.mEndQuery && g.mGetQueryObjectiv && g.mGetQueryObjectui64v;
+		if (g.mAvailable)
+			g.mGenQueries(HITCH_GPU_RING, g.mQueries);
+		SDL_Log("PVZP_HITCH gpu timer %s", g.mAvailable ? "on" : "unavailable");
+	}
+	if (!g.mAvailable)
+		return anId;
+	if (g.mRunning)
+	{
+		g.mEndQuery(HITCH_GL_TIME_ELAPSED);
+		g.mPending[g.mRunningSlot] = true;
+		g.mIdOf[g.mRunningSlot] = anId;
+		g.mRunning = false;
+	}
+	for (int i = 0; i < HITCH_GPU_RING; i++)
+	{
+		if (!g.mPending[i])
+			continue;
+		GLint aReady = 0;
+		g.mGetQueryObjectiv(g.mQueries[i], HITCH_GL_QUERY_RESULT_AVAILABLE, &aReady);
+		if (!aReady)
+			continue;
+		uint64_t aNs = 0;
+		g.mGetQueryObjectui64v(g.mQueries[i], HITCH_GL_QUERY_RESULT, &aNs);
+		g.mPending[i] = false;
+		HitchStoreGpuMs(g.mIdOf[i], aNs / 1.0e6);
+	}
+	const int aSlot = (g.mRunningSlot + 1) % HITCH_GPU_RING;
+	g.mPending[aSlot] = false; // a result that never arrived within the ring is dropped
+	g.mBeginQuery(HITCH_GL_TIME_ELAPSED, g.mQueries[aSlot]);
+	g.mRunningSlot = aSlot;
+	g.mRunning = true;
+#endif
+	return anId;
+}
+
+// Stops the running query (the logger was turned off or restarted).
+void HitchGpuTimerStop()
+{
+#ifdef PVZP_HITCH_GPU_TIMER
+	if (gHitchGpu.mRunning)
+	{
+		gHitchGpu.mEndQuery(HITCH_GL_TIME_ELAPSED);
+		gHitchGpu.mRunning = false;
+	}
+	for (bool& aPending : gHitchGpu.mPending)
+		aPending = false;
+#endif
+}
+
+// Prints the hitch lines whose GPU time is known, or that waited long enough (gpu=-1: no result).
+void HitchFlushPendingLines(bool theAll)
+{
+	while (!gHitchPendingLines.empty())
+	{
+		const HitchPendingLine& aLine = gHitchPendingLines.front();
+		const bool aKnown = gHitchGpuId[aLine.mPresentId % HITCH_GPU_HISTORY] == aLine.mPresentId;
+		if (!aKnown && !theAll && gHitchPresentCount - aLine.mPresentId < 12)
+			break;
+		SDL_Log("%s gpu=%.1f %s", aLine.mHead.c_str(), aKnown ? gHitchGpuMs[aLine.mPresentId % HITCH_GPU_HISTORY] : -1.0,
+			aLine.mTail.c_str());
+		gHitchPendingLines.pop_front();
+	}
+}
+
+double HitchTicksToMs(uint64_t theTicks)
+{
+	return (double)theTicks * 1000.0 / (double)SDL_GetPerformanceFrequency();
+}
+
+bool HitchOnMainThread()
+{
+	return std::this_thread::get_id() == gPvzpHitchMainThread;
+}
+
+void HitchResetStats()
+{
+	gHitchStats = HitchStats();
+	gHitchStats.mStartTicks = gHitchLastFrameEnd != 0 ? gHitchLastFrameEnd : PvzpHitchTicks();
+}
+
+std::unordered_set<const MemoryImage*> gHitchTexKnown;	// images that had textures at the previous scan
+
+// Textures known to the GL interface: count, bytes and bit changes (each change is a re-upload when next drawn).
+// theNoteNew: name the images whose textures were created since the previous scan in the frame's notes.
+void HitchScanTextures(SexyAppBase* theApp, long& theImages, int64_t& theBytes, int64_t& theBitsChanged, bool theNoteNew)
+{
+	theImages = 0;
+	theBytes = 0;
+	theBitsChanged = 0;
+	GLInterface* anInterface = theApp->mGLInterface.get();
+	if (anInterface == nullptr)
+		return;
+	std::unordered_set<const MemoryImage*> aKnown;
+	aKnown.reserve(gHitchTexKnown.size() + 16);
+	std::scoped_lock aLock(anInterface->mCritSect);
+	for (MemoryImage* anImage : anInterface->mImageSet)
+	{
+		const TextureData* aData = anImage->mRenderData;
+		if (aData == nullptr || aData->mPixelFormat == PixelFormat_Unknown)
+			continue;
+		theImages++;
+		theBytes += aData->mTexMemSize;
+		theBitsChanged += aData->mBitsChangedCount;
+		aKnown.insert(anImage);
+		if (theNoteNew && gHitchTexKnown.find(anImage) == gHitchTexKnown.end())
+		{
+			const std::string& aPath = anImage->mFilePath;
+			const size_t aSlash = aPath.find_last_of("/\\");
+			PvzpHitchNoteSlow("tex", !aPath.empty() ? aPath.substr(aSlash == std::string::npos ? 0 : aSlash + 1) :
+				std::to_string(anImage->mWidth) + "x" + std::to_string(anImage->mHeight));
+		}
+	}
+	gHitchTexKnown.swap(aKnown);
+}
+
+}
+
+uint64_t PvzpHitchTicks()
+{
+	return SDL_GetPerformanceCounter();
+}
+
+void PvzpHitchCountSlow(PvzpHitchCounter theCounter, int64_t theAmount)
+{
+	if (HitchOnMainThread())
+		gHitchFrame.mCounters[theCounter] += theAmount;
+}
+
+void PvzpHitchNoteSlow(const char* theKind, std::string_view theName)
+{
+	if (!HitchOnMainThread())
+		return;
+	if (++gHitchFrame.mNoteCount > 8)
+		return;
+	if (!gHitchFrame.mNotes.empty())
+		gHitchFrame.mNotes += ' ';
+	gHitchFrame.mNotes += theKind;
+	gHitchFrame.mNotes += ':';
+	gHitchFrame.mNotes += theName.substr(0, 60);
+}
+
+void PvzpHitchAddPhaseSlow(PvzpHitchPhase thePhase, uint64_t theStartTicks)
+{
+	if (!HitchOnMainThread())
+		return;
+	const uint64_t aTicks = PvzpHitchTicks() - theStartTicks;
+	gHitchFrame.mPhaseTicks[thePhase] += aTicks;
+	gHitchFrame.mPhaseMaxTicks[thePhase] = std::max(gHitchFrame.mPhaseMaxTicks[thePhase], aTicks);
+}
+
+void PvzpHitchScopeEndSlow(PvzpHitchCounter theCountCounter, PvzpHitchCounter theTimeCounter, uint64_t theStartTicks)
+{
+	if (!HitchOnMainThread())
+		return;
+	gHitchFrame.mCounters[theCountCounter]++;
+	gHitchFrame.mCounters[theTimeCounter] += (int64_t)(HitchTicksToMs(PvzpHitchTicks() - theStartTicks) * 1000.0);
+}
+
+static void PvzpHitchLogStats();
+
+void PvzpHitchFrameEnd(SexyAppBase* theApp)
+{
+	if (!gPvzpHitchOn || !HitchOnMainThread())
+		return;
+
+	const uint64_t aNow = PvzpHitchTicks();
+	long aTexImages = 0;
+	int64_t aTexBytes = 0, aTexBitsChanged = 0;
+	HitchScanTextures(theApp, aTexImages, aTexBytes, aTexBitsChanged, gHitchTexScanValid);
+
+	if (gHitchLastFrameEnd != 0)
+	{
+		const double anIntervalMs = HitchTicksToMs(aNow - gHitchLastFrameEnd);
+		gHitchFrameNumber++;
+		gHitchStats.mFrames++;
+		for (int i = 0; i < 4; i++)
+			if (anIntervalMs > HITCH_STAT_LIMITS[i])
+				gHitchStats.mOver[i]++;
+		gHitchStats.mWorstMs = std::max(gHitchStats.mWorstMs, anIntervalMs);
+		for (int i = 0; i < NUM_HITCH_PHASES; i++)
+		{
+			const double aPhaseMs = HitchTicksToMs(gHitchFrame.mPhaseTicks[i]);
+			gHitchStats.mPhaseSumMs[i] += aPhaseMs;
+			gHitchStats.mPhaseMaxMs[i] = std::max(gHitchStats.mPhaseMaxMs[i], aPhaseMs);
+		}
+		gHitchStats.mStepMaxMs = std::max(gHitchStats.mStepMaxMs, HitchTicksToMs(gHitchFrame.mPhaseMaxTicks[HITCH_PHASE_UPDATE]));
+		{
+			constexpr double aLimits[6] = { 17.5, 20.0, 25.0, 33.4, 50.0, 100.0 };
+			int aBin = 0;
+			while (aBin < 6 && anIntervalMs > aLimits[aBin])
+				aBin++;
+			gHitchStats.mHist[aBin]++;
+		}
+
+		if (anIntervalMs > gPvzpHitchThresholdMs)
+		{
+			const HitchFrame& f = gHitchFrame;
+			auto P = [&](PvzpHitchPhase thePhase) { return HitchTicksToMs(f.mPhaseTicks[thePhase]); };
+			const double aSwapMs = f.mFlushDoneTicks != 0 ? HitchTicksToMs(aNow - f.mFlushDoneTicks) : 0.0;
+			const double aFlushMs = std::max(0.0, P(HITCH_PHASE_PRESENT) - aSwapMs);
+			const double anOtherMs = anIntervalMs - P(HITCH_PHASE_EVENTS) - P(HITCH_PHASE_UPDATE) - P(HITCH_PHASE_DRAW) -
+				P(HITCH_PHASE_PRESENT) - P(HITCH_PHASE_SLEEP);
+			const int64_t* c = f.mCounters;
+			float aCubicArea = 0, aCubicBudget = 0;
+			bool anEconomy = false;
+			long anEconomyFrames = 0;
+			GLInterface::GetCubicBudgetState(aCubicArea, aCubicBudget, anEconomy, anEconomyFrames);
+			char aHead[96];
+			snprintf(aHead, sizeof(aHead), "PVZP_HITCH frame=%ld t=%.3f interval=%.1f", gHitchFrameNumber,
+				SDL_GetTicks() / 1000.0, anIntervalMs);
+			char aTail[1024];
+			snprintf(aTail, sizeof(aTail), "events=%.1f update=%.1f steps=%d maxstep=%.1f music=%.1f "
+				"draw=%.1f flush=%.1f swap=%.1f sleep=%.1f other=%.1f | img=%lld/%.1fms/%lldkpx defs=%lld/%.1fms "
+				"cachew=%lld snd=%lld/%.1fms mus=%lld glyph=%lld/%.1fms trim=%lld disk=%lld/%lldKB fw=%lld/%.1fms "
+				"log=%lld grp=%lld tex=%+ld/%+lldKB bitsch=%lld acc=%.0f eco=%d cubicMpx=%.1f | %s",
+				P(HITCH_PHASE_EVENTS), P(HITCH_PHASE_UPDATE),
+				(int)(theApp->mUpdateCount - gHitchLastUpdateCount), HitchTicksToMs(f.mPhaseMaxTicks[HITCH_PHASE_UPDATE]),
+				P(HITCH_PHASE_MUSIC), P(HITCH_PHASE_DRAW), aFlushMs, aSwapMs, P(HITCH_PHASE_SLEEP), anOtherMs,
+				(long long)c[HITCH_IMAGE_DECODES], c[HITCH_IMAGE_DECODE_US] / 1000.0, (long long)c[HITCH_IMAGE_KPIXELS],
+				(long long)c[HITCH_DEF_LOADS], c[HITCH_DEF_LOAD_US] / 1000.0, (long long)c[HITCH_DEF_CACHE_WRITES],
+				(long long)c[HITCH_SOUND_DECODES], c[HITCH_SOUND_DECODE_US] / 1000.0, (long long)c[HITCH_MUSIC_LOADS],
+				(long long)c[HITCH_GLYPHS], c[HITCH_GLYPH_US] / 1000.0, (long long)c[HITCH_GLYPH_TRIMS],
+				(long long)c[HITCH_DISK_OPENS], (long long)(c[HITCH_DISK_READ_BYTES] / 1024), (long long)c[HITCH_FILE_WRITES],
+				c[HITCH_FILE_WRITE_US] / 1000.0, (long long)c[HITCH_LOG_LINES], (long long)c[HITCH_RES_GROUPS],
+				gHitchTexScanValid ? aTexImages - gHitchTexImages : 0L,
+				(long long)(gHitchTexScanValid ? (aTexBytes - gHitchTexBytes) / 1024 : 0),
+				(long long)(gHitchTexScanValid ? aTexBitsChanged - gHitchTexBitsChanged : 0),
+				theApp->mUpdateFTimeAcc, anEconomy ? 1 : 0, aCubicArea / 1.0e6f, f.mNotes.c_str());
+			gHitchPendingLines.push_back({ f.mPresentId, aHead, aTail });
+		}
+	}
+	HitchFlushPendingLines(false);
+
+	if (gPvzpHitchAutoStats && gHitchStats.mStartTicks != 0 && HitchTicksToMs(aNow - gHitchStats.mStartTicks) >= 60000.0)
+		PvzpHitchLogStats();
+
+	gHitchFrame = HitchFrame();
+	gHitchLastFrameEnd = PvzpHitchTicks(); // the scan and the log line above belong to the next frame's "other"
+	gHitchLastUpdateCount = theApp->mUpdateCount;
+	gHitchTexScanValid = true;
+	gHitchTexImages = aTexImages;
+	gHitchTexBytes = aTexBytes;
+	gHitchTexBitsChanged = aTexBitsChanged;
+	if (gHitchStats.mStartTicks == 0)
+		HitchResetStats();
+}
+
+static void PvzpHitchLogStats()
+{
+	HitchFlushPendingLines(true);
+	const double anElapsedMs = gHitchStats.mStartTicks != 0 && gHitchLastFrameEnd > gHitchStats.mStartTicks ?
+		HitchTicksToMs(gHitchLastFrameEnd - gHitchStats.mStartTicks) : 0.0;
+	const HitchStats& s = gHitchStats;
+	SDL_Log("PVZP_HITCH stats frames=%ld elapsed=%.0fms fps=%.1f over25=%ld over33=%ld over50=%ld over100=%ld worst=%.1fms "
+		"gpuMean=%.2fms gpuMax=%.1fms gpuOver16=%ld", s.mFrames, anElapsedMs, anElapsedMs > 0 ? s.mFrames * 1000.0 / anElapsedMs : 0.0,
+		s.mOver[0], s.mOver[1], s.mOver[2], s.mOver[3], s.mWorstMs, s.mGpuFrames > 0 ? s.mGpuSumMs / s.mGpuFrames : -1.0,
+		s.mGpuMaxMs, s.mGpuOver16);
+	const double aFrames = std::max(1L, s.mFrames);
+	SDL_Log("PVZP_HITCH phases mean/max ms per frame: events=%.2f/%.1f update=%.2f/%.1f music=%.2f/%.1f draw=%.2f/%.1f "
+		"present=%.2f/%.1f sleep=%.2f/%.1f maxstep=%.1f hist(<=17.5,20,25,33.4,50,100,>100)=%ld/%ld/%ld/%ld/%ld/%ld/%ld",
+		s.mPhaseSumMs[HITCH_PHASE_EVENTS] / aFrames, s.mPhaseMaxMs[HITCH_PHASE_EVENTS],
+		s.mPhaseSumMs[HITCH_PHASE_UPDATE] / aFrames, s.mPhaseMaxMs[HITCH_PHASE_UPDATE],
+		s.mPhaseSumMs[HITCH_PHASE_MUSIC] / aFrames, s.mPhaseMaxMs[HITCH_PHASE_MUSIC],
+		s.mPhaseSumMs[HITCH_PHASE_DRAW] / aFrames, s.mPhaseMaxMs[HITCH_PHASE_DRAW],
+		s.mPhaseSumMs[HITCH_PHASE_PRESENT] / aFrames, s.mPhaseMaxMs[HITCH_PHASE_PRESENT],
+		s.mPhaseSumMs[HITCH_PHASE_SLEEP] / aFrames, s.mPhaseMaxMs[HITCH_PHASE_SLEEP], s.mStepMaxMs,
+		s.mHist[0], s.mHist[1], s.mHist[2], s.mHist[3], s.mHist[4], s.mHist[5], s.mHist[6]);
+	HitchResetStats();
+}
+
+// Area-weighted resampling of one axis: theDst[i] = mean of theSrc over [i, i + 1) * theSrcLen / theDstLen.
+static void PvzpTestBoxResample(const float* theSrc, int theSrcLen, int theSrcStride, float* theDst, int theDstLen, int theDstStride)
+{
+	const double aRatio = (double)theSrcLen / theDstLen;
+	for (int i = 0; i < theDstLen; i++)
+	{
+		double aStart = i * aRatio, anEnd = (i + 1) * aRatio, aSum = 0;
+		for (int j = (int)aStart; j < theSrcLen && j < anEnd; j++)
+		{
+			double aCover = std::min<double>(j + 1, anEnd) - std::max<double>(j, aStart);
+			if (aCover > 0)
+				aSum += aCover * theSrc[(size_t)j * theSrcStride];
+		}
+		theDst[(size_t)i * theDstStride] = (float)(aSum / aRatio);
+	}
+}
